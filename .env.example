# Environment variables template for Secrets Gradle Plugin & GoLocal Cloud Functions
# Enter real values securely via AI Studio Secrets panel or GitHub Actions / Cloud Secret Manager.

# Optional custom OpenStreetMap tile / OSRM / Nominatim endpoints (leave blank for defaults)
OSM_TILE_URL_TEMPLATE=
OSRM_BASE_URL=
GEOCODING_BASE_URL=

# Optional Firebase Realtime Database override URL
FIREBASE_RTDB_URL=

# Optional Release APK Update Manifest URL
UPDATE_MANIFEST_URL=

# Cloud Functions Payment Webhook HMAC Secret (set in Firebase Functions Secrets / CI)
PAYMENT_WEBHOOK_SECRET=
