# GOLOCAL by NR Next — Environment Configuration Placeholders
# Never commit real secret keys or service-account credentials.
# Configure runtime client secrets via the AI Studio Secrets panel,
# and server-side secrets (Razorpay / Cashfree) in Cloud Functions Secret Manager.

# Optional Google Maps Platform API Key (uncomment and set in Secrets panel if enabling Maps SDK)
# MAPS_API_KEY=NOT_CONFIGURED

# Approved Payment Gateway (Razorpay / Cashfree) — Server-side Cloud Functions only (NEVER ship in APK)
# PAYMENT_GATEWAY_KEY_ID=NOT_CONFIGURED
# PAYMENT_GATEWAY_KEY_SECRET=NOT_CONFIGURED
# PAYMENT_WEBHOOK_SECRET=NOT_CONFIGURED

# Support Helpline Number for Community Transport Access (E.164 format)
# GOLOCAL_SUPPORT_HELPLINE=+911800000000
