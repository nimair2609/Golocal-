rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'renukadas083@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
             (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isVerifiedDriver() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/driver_profiles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/driver_profiles/$(request.auth.uid)).data.verificationStatus == 'verified';
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    // --- Validation Helpers ---
    function isValidUserAccount(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             data.role in ['customer', 'driver', 'admin'] &&
             data.preferredLanguage in ['en', 'bn', 'hi'] &&
             data.accountStatus in ['active', 'restricted', 'deletion_requested'] &&
             isOptionalString(data, 'email', 150) &&
             isOptionalString(data, 'phone', 25) &&
             isOptionalString(data, 'photoUrl', 500) &&
             (!('lowNetworkMode' in data) || data.lowNetworkMode is bool) &&
             (!('privacyConsentAccepted' in data) || data.privacyConsentAccepted is bool) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCustomerProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             isOptionalString(data, 'homeAddress', 240) &&
             isOptionalString(data, 'workAddress', 240) &&
             isOptionalString(data, 'nativeVillage', 120) &&
             isOptionalString(data, 'nativeDistrict', 80) &&
             isOptionalString(data, 'emergencyContactName', 100) &&
             isOptionalString(data, 'emergencyContactPhone', 25) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDriverProfile(data) {
      return data.driverId is string && data.driverId.size() <= 128 &&
             data.legalName is string && data.legalName.size() >= 2 && data.legalName.size() <= 100 &&
             data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 25 &&
             data.district is string && data.district.size() >= 2 && data.district.size() <= 80 &&
             isOptionalString(data, 'address', 240) &&
             isOptionalString(data, 'block', 80) &&
             data.vehicleCategory in ['bike', 'auto', 'toto', 'cab'] &&
             isOptionalString(data, 'vehicleModel', 80) &&
             data.vehicleRegNumber is string && data.vehicleRegNumber.size() >= 4 && data.vehicleRegNumber.size() <= 30 &&
             data.drivingLicenceNumber is string && data.drivingLicenceNumber.size() >= 4 && data.drivingLicenceNumber.size() <= 40 &&
             isOptionalString(data, 'rcNumber', 40) &&
             isOptionalString(data, 'insuranceNumber', 60) &&
             isOptionalString(data, 'permitInfo', 120) &&
             isOptionalString(data, 'settlementUpiOrBank', 100) &&
             isOptionalString(data, 'documentPhotoUri', 500) &&
             data.verificationStatus in ['pending', 'verified', 'rejected', 'suspended'] &&
             isOptionalString(data, 'rejectionReason', 300) &&
             data.isOnline is bool &&
             (!('ratingAvg' in data) || (data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5)) &&
             (!('completedRides' in data) || (data.completedRides is int && data.completedRides >= 0)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDriverDirectory(data) {
      return data.driverId is string && data.driverId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.vehicleCategory in ['bike', 'auto', 'toto', 'cab'] &&
             isOptionalString(data, 'vehicleModel', 80) &&
             isOptionalString(data, 'maskedPlate', 30) &&
             data.district is string && data.district.size() <= 80 &&
             isOptionalString(data, 'block', 80) &&
             data.verificationStatus in ['pending', 'verified', 'rejected', 'suspended'] &&
             data.isOnline is bool &&
             (!('currentLat' in data) || data.currentLat is number) &&
             (!('currentLng' in data) || data.currentLng is number) &&
             (!('ratingAvg' in data) || data.ratingAvg is number) &&
             (!('completedRides' in data) || data.completedRides is int) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidServiceArea(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
             isOptionalString(data, 'nameBn', 120) &&
             data.district is string && data.district.size() >= 2 && data.district.size() <= 80 &&
             isOptionalString(data, 'block', 80) &&
             data.zoneType in ['railway_station', 'bus_stand', 'airport', 'village', 'hospital', 'market', 'town'] &&
             (!('lat' in data) || data.lat is number) &&
             (!('lng' in data) || data.lng is number) &&
             data.isActive is bool &&
             (!('parcelApproved' in data) || data.parcelApproved is bool) &&
             isOptionalString(data, 'operationalHours', 60) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFareConfig(data) {
      return data.vehicleCategory in ['bike', 'auto', 'toto', 'cab', 'outstation', 'scheduled', 'parcel'] &&
             data.version is int && data.version >= 1 &&
             data.baseFareInr is number && data.baseFareInr >= 0 &&
             data.perKmRateInr is number && data.perKmRateInr >= 0 &&
             data.minimumFareInr is number && data.minimumFareInr >= 0 &&
             (!('waitingChargePerMinInr' in data) || data.waitingChargePerMinInr is number) &&
             (!('cancellationFeeInr' in data) || data.cancellationFeeInr is number) &&
             data.gstPercent is number && data.gstPercent >= 0 && data.gstPercent <= 28 &&
             data.commissionPercent is number && data.commissionPercent >= 0 && data.commissionPercent <= 40 &&
             data.allowDriverFareProposal is bool &&
             (!('minBidFactor' in data) || (data.minBidFactor is number && data.minBidFactor >= 0.7 && data.minBidFactor <= 1.0)) &&
             (!('maxBidFactor' in data) || (data.maxBidFactor is number && data.maxBidFactor >= 1.0 && data.maxBidFactor <= 1.5)) &&
             data.isEnabled is bool &&
             isOptionalString(data, 'updatedBy', 128) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBooking(data) {
      return data.customerId is string && data.customerId.size() <= 128 &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
             (!('bookingChannel' in data) || data.bookingChannel in ['app', 'community_center']) &&
             data.bookingType in [
               'now', 'scheduled', 'station_pickup', 'bus_stand_pickup',
               'airport_transfer', 'village_to_town', 'native_village', 'family', 'return_trip'
             ] &&
             data.vehicleCategory in ['bike', 'auto', 'toto', 'cab', 'outstation', 'scheduled', 'parcel'] &&
             data.pickupLabel is string && data.pickupLabel.size() >= 1 && data.pickupLabel.size() <= 200 &&
             isOptionalString(data, 'pickupDistrict', 80) &&
             (!('pickupLat' in data) || data.pickupLat is number) &&
             (!('pickupLng' in data) || data.pickupLng is number) &&
             data.destinationLabel is string && data.destinationLabel.size() >= 1 && data.destinationLabel.size() <= 200 &&
             isOptionalString(data, 'destinationDistrict', 80) &&
             (!('destinationLat' in data) || data.destinationLat is number) &&
             (!('destinationLng' in data) || data.destinationLng is number) &&
             data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 2000 &&
             (!('estimatedDurationMin' in data) || (data.estimatedDurationMin is int && data.estimatedDurationMin >= 0)) &&
             data.estimatedFareInr is number && data.estimatedFareInr >= 0 &&
             data.minPermittedFareInr is number && data.minPermittedFareInr >= 0 &&
             data.maxPermittedFareInr is number && data.maxPermittedFareInr >= data.minPermittedFareInr &&
             (!('agreedFareInr' in data) || data.agreedFareInr is number) &&
             (!('fareConfigVersion' in data) || data.fareConfigVersion is int) &&
             (!('commissionPercent' in data) || data.commissionPercent is number) &&
             (!('gstPercent' in data) || data.gstPercent is number) &&
             data.paymentMethod in ['cash', 'upi'] &&
             data.paymentStatus in ['pending', 'pending_verification', 'settled_cash', 'paid', 'refunded'] &&
             data.status in ['searching', 'assigned', 'arriving', 'arrived', 'in_progress', 'completed', 'cancelled'] &&
             isOptionalString(data, 'assignedDriverId', 128) &&
             isOptionalString(data, 'assignedDriverName', 100) &&
             isOptionalString(data, 'assignedVehicleLabel', 100) &&
             isOptionalString(data, 'acceptedOfferId', 128) &&
             isOptionalString(data, 'tripPin', 10) &&
             isOptionalString(data, 'trainNumber', 30) &&
             isOptionalString(data, 'scheduledDateTimeLabel', 80) &&
             isOptionalString(data, 'familyMemberName', 100) &&
             (!('familyConsentConfirmed' in data) || data.familyConsentConfirmed is bool) &&
             (!('isRoundTrip' in data) || data.isRoundTrip is bool) &&
             isOptionalString(data, 'cancellationReason', 250) &&
             (!('customerRating' in data) || (data.customerRating is int && data.customerRating >= 1 && data.customerRating <= 5)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRideOffer(data) {
      return data.bookingId is string && isValidId(data.bookingId) &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.driverName is string && data.driverName.size() >= 1 && data.driverName.size() <= 100 &&
             data.vehicleCategory in ['bike', 'auto', 'toto', 'cab', 'outstation', 'scheduled', 'parcel'] &&
             isOptionalString(data, 'vehicleLabel', 100) &&
             (!('driverRating' in data) || data.driverRating is number) &&
             (!('driverCompletedRides' in data) || data.driverCompletedRides is int) &&
             (!('isVerifiedDriver' in data) || data.isVerifiedDriver is bool) &&
             data.etaMinutes is int && data.etaMinutes >= 1 && data.etaMinutes <= 240 &&
             data.proposedFareInr is number && data.proposedFareInr >= 1 &&
             data.status in ['pending', 'accepted', 'rejected', 'expired'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRideAssignment(data) {
      return data.bookingId is string && isValidId(data.bookingId) &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             isOptionalString(data, 'offerId', 128) &&
             data.lockedFareInr is number && data.lockedFareInr >= 1 &&
             data.status in ['active', 'completed', 'cancelled'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTripLocation(data) {
      return data.bookingId is string && isValidId(data.bookingId) &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.lat is number && data.lng is number &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPaymentRecord(data) {
      return data.bookingId is string && isValidId(data.bookingId) &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.grossFareInr is number && data.grossFareInr >= 0 &&
             data.gstInr is number && data.gstInr >= 0 &&
             data.platformCommissionInr is number && data.platformCommissionInr >= 0 &&
             data.netDriverEarningsInr is number && data.netDriverEarningsInr >= 0 &&
             data.paymentMethod in ['cash', 'upi'] &&
             isOptionalString(data, 'gatewayReference', 128) &&
             data.status in ['settled_cash', 'pending_verification', 'paid', 'refunded'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCommissionRecord(data) {
      return data.bookingId is string && isValidId(data.bookingId) &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.grossFareInr is number && data.grossFareInr >= 0 &&
             data.commissionRatePct is number && data.commissionRatePct >= 0 && data.commissionRatePct <= 40 &&
             data.commissionAmountInr is number && data.commissionAmountInr >= 0 &&
             data.netDriverEarningsInr is number && data.netDriverEarningsInr >= 0 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidDriverSettlement(data) {
      return data.driverId is string && data.driverId.size() <= 128 &&
             data.driverName is string && data.driverName.size() >= 1 && data.driverName.size() <= 100 &&
             data.amountInr is number && data.amountInr >= 50 && data.amountInr <= 100000 &&
             data.upiOrBankRef is string && data.upiOrBankRef.size() >= 3 && data.upiOrBankRef.size() <= 100 &&
             data.status in ['requested', 'processing', 'paid', 'rejected'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRefundRecord(data) {
      return data.bookingId is string && isValidId(data.bookingId) &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.amountInr is number && data.amountInr >= 1 &&
             data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 300 &&
             data.status in ['requested', 'approved', 'processed', 'rejected'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRatingRecord(data) {
      return data.bookingId is string && isValidId(data.bookingId) &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.stars is int && data.stars >= 1 && data.stars <= 5 &&
             isOptionalString(data, 'review', 300) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidComplaintRecord(data) {
      return data.reporterId is string && data.reporterId.size() <= 128 &&
             isOptionalString(data, 'bookingId', 128) &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 80 &&
             data.description is string && data.description.size() >= 5 && data.description.size() <= 500 &&
             data.status in ['open', 'investigating', 'resolved'] &&
             isOptionalString(data, 'resolutionNote', 300) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidEmergencyEvent(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             isOptionalString(data, 'bookingId', 128) &&
             (!('lat' in data) || data.lat is number) &&
             (!('lng' in data) || data.lng is number) &&
             data.notes is string && data.notes.size() >= 2 && data.notes.size() <= 300 &&
             data.status in ['active', 'acknowledged', 'resolved'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNotification(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 300 &&
             data.type is string && data.type.size() >= 1 && data.type.size() <= 50 &&
             data.read is bool &&
             isValidTimestamp(data.createdAt);
    }

    function isValidSupportRequest(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.requestType in ['community_booking', 'account_deletion', 'privacy_inquiry', 'general_support'] &&
             data.details is string && data.details.size() >= 3 && data.details.size() <= 500 &&
             data.status in ['submitted', 'in_review', 'completed'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAuditLog(data) {
      return data.actorId is string && data.actorId.size() <= 128 &&
             isOptionalString(data, 'actorEmail', 150) &&
             data.action is string && data.action.size() >= 2 && data.action.size() <= 80 &&
             data.targetCollection is string && data.targetCollection.size() >= 2 && data.targetCollection.size() <= 80 &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 300 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidPlatformSettings(data) {
      return isOptionalString(data, 'helplineNumber', 30) &&
             (!('parcelDeliveryEnabled' in data) || data.parcelDeliveryEnabled is bool) &&
             isOptionalString(data, 'maintenanceNotice', 300) &&
             isOptionalString(data, 'cancellationPolicySummary', 400) &&
             (!('defaultCommissionPct' in data) || (data.defaultCommissionPct is number && data.defaultCommissionPct >= 0 && data.defaultCommissionPct <= 40)) &&
             (!('updatesEnabled' in data) || data.updatesEnabled is bool) &&
             isOptionalString(data, 'latestVersionName', 32) &&
             (!('latestVersionCode' in data) || (data.latestVersionCode is int && data.latestVersionCode >= 1)) &&
             (!('minSupportedVersionCode' in data) || (data.minSupportedVersionCode is int && data.minSupportedVersionCode >= 1)) &&
             isOptionalString(data, 'apkDownloadUrl', 500) &&
             isOptionalString(data, 'sha256Checksum', 64) &&
             isOptionalString(data, 'releaseNotes', 1000) &&
             (!('isMandatoryUpdate' in data) || data.isMandatoryUpdate is bool) &&
             isOptionalString(data, 'updateManifestUrl', 500) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- Collection Rules ---

    // 1. User accounts (PII isolated to owner or Admin; self-assigning 'admin' or mutating role blocked)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       (incoming().role in ['customer', 'driver'] || isAdmin()) &&
                       incoming().accountStatus == 'active' &&
                       isValidUserAccount(incoming());
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserAccount(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (request.auth.uid == userId &&
                          incoming().role == existing().role &&
                          incoming().accountStatus == existing().accountStatus &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'fullName', 'phone', 'photoUrl', 'preferredLanguage',
                            'lowNetworkMode', 'privacyConsentAccepted', 'updatedAt'
                          ]))
                       );
      allow delete: if isAdmin();
    }

    // 2. Customer profiles (PII isolated)
    match /customer_profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       isValidCustomerProfile(incoming());
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidCustomerProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 3. Private driver KYC profiles (owner cannot self-verify)
    match /driver_profiles/{driverId} {
      allow get: if isSignedIn() && isValidId(driverId) && (request.auth.uid == driverId || isAdmin());
      allow list: if isSignedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(driverId) &&
                       request.auth.uid == driverId &&
                       incoming().driverId == request.auth.uid &&
                       incoming().verificationStatus == 'pending' &&
                       incoming().isOnline == false &&
                       isValidDriverProfile(incoming());
      allow update: if isSignedIn() &&
                       isValidId(driverId) &&
                       isValidDriverProfile(incoming()) &&
                       incoming().driverId == existing().driverId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (request.auth.uid == driverId &&
                          incoming().verificationStatus == existing().verificationStatus &&
                          incoming().ratingAvg == existing().ratingAvg &&
                          incoming().completedRides == existing().completedRides &&
                          (incoming().isOnline == false || existing().verificationStatus == 'verified') &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'isOnline', 'phone', 'address', 'district', 'block', 'vehicleModel',
                            'insuranceNumber', 'permitInfo', 'settlementUpiOrBank', 'documentPhotoUri', 'updatedAt'
                          ]))
                       );
      allow delete: if isAdmin();
    }

    // 4. Public verified driver discovery directory (no PII)
    match /driver_directory/{driverId} {
      allow get: if isSignedIn() && isValidId(driverId) &&
                    (existing().verificationStatus == 'verified' || request.auth.uid == driverId || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.verificationStatus == 'verified' ||
                      resource.data.driverId == request.auth.uid ||
                      isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(driverId) &&
                       isValidDriverDirectory(incoming()) && (
                         isAdmin() ||
                         (request.auth.uid == driverId &&
                          incoming().driverId == request.auth.uid &&
                          incoming().verificationStatus == 'pending' &&
                          incoming().isOnline == false)
                       );
      allow update: if isSignedIn() &&
                       isValidId(driverId) &&
                       isValidDriverDirectory(incoming()) &&
                       incoming().driverId == existing().driverId && (
                         isAdmin() ||
                         (request.auth.uid == driverId &&
                          incoming().verificationStatus == existing().verificationStatus &&
                          (incoming().isOnline == false || existing().verificationStatus == 'verified') &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'isOnline', 'currentLat', 'currentLng', 'updatedAt'
                          ]))
                       );
      allow delete: if isAdmin();
    }

    // 5. Service areas (public catalog for signed-in users; Admin managed)
    match /service_areas/{areaId} {
      allow get: if isSignedIn() && isValidId(areaId);
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(areaId) && isValidServiceArea(incoming());
      allow delete: if isAdmin() && isValidId(areaId);
    }

    // 6. Versioned fare configurations (public catalog for signed-in users; Admin managed)
    match /fare_configs/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(configId) && isValidFareConfig(incoming());
      allow delete: if isAdmin() && isValidId(configId);
    }

    // 7. Bookings (searching bookings readable only by verified drivers, owner, or admin; controlled lifecycle)
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) &&
                    (existing().customerId == request.auth.uid ||
                     existing().assignedDriverId == request.auth.uid ||
                     (existing().status == 'searching' && isVerifiedDriver()) ||
                     isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.assignedDriverId == request.auth.uid ||
                      (resource.data.status == 'searching' && isVerifiedDriver()) ||
                      isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(bookingId) &&
                       incoming().customerId == request.auth.uid &&
                       incoming().status == 'searching' &&
                       incoming().paymentStatus == 'pending' &&
                       isValidBooking(incoming());
      allow update: if isSignedIn() &&
                       isValidId(bookingId) &&
                       isValidBooking(incoming()) &&
                       incoming().customerId == existing().customerId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         // Action: Customer confirms an accepted offer (searching -> assigned)
                         (request.auth.uid == existing().customerId &&
                          existing().status == 'searching' &&
                          incoming().status == 'assigned' &&
                          incoming().assignedDriverId is string && incoming().assignedDriverId.size() >= 1 &&
                          incoming().acceptedOfferId is string && isValidId(incoming().acceptedOfferId) &&
                          exists(/databases/$(database)/documents/ride_offers/$(incoming().acceptedOfferId)) &&
                          get(/databases/$(database)/documents/ride_offers/$(incoming().acceptedOfferId)).data.bookingId == bookingId &&
                          get(/databases/$(database)/documents/ride_offers/$(incoming().acceptedOfferId)).data.driverId == incoming().assignedDriverId &&
                          !exists(/databases/$(database)/documents/ride_assignments/$(bookingId)) &&
                          incoming().agreedFareInr >= existing().minPermittedFareInr &&
                          incoming().agreedFareInr <= existing().maxPermittedFareInr &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'assignedDriverId', 'assignedDriverName', 'assignedVehicleLabel',
                            'acceptedOfferId', 'agreedFareInr', 'tripPin', 'updatedAt'
                          ])) ||
                         // Action: Customer cancels before trip starts
                         (request.auth.uid == existing().customerId &&
                          existing().status in ['searching', 'assigned', 'arriving', 'arrived'] &&
                          incoming().status == 'cancelled' &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'cancellationReason', 'updatedAt'
                          ])) ||
                         // Action: Customer submits rating after completion
                         (request.auth.uid == existing().customerId &&
                          existing().status == 'completed' &&
                          incoming().status == 'completed' &&
                          !('customerRating' in existing()) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['customerRating', 'updatedAt'])) ||
                         // Action: Assigned driver advances active trip state
                         (request.auth.uid == existing().assignedDriverId &&
                          !(existing().status in ['completed', 'cancelled']) &&
                          ((existing().status == 'assigned' && incoming().status == 'arriving') ||
                           (existing().status == 'arriving' && incoming().status == 'arrived') ||
                           (existing().status == 'arrived' && incoming().status == 'in_progress') ||
                           (existing().status == 'in_progress' && incoming().status == 'completed')) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'paymentStatus', 'updatedAt'
                          ]))
                       );
      allow delete: if false;
    }

    // 8. Controlled driver fare proposals (strictly gated to verified drivers & permitted fare bounds)
    match /ride_offers/{offerId} {
      allow get: if isSignedIn() && isValidId(offerId) &&
                    (existing().customerId == request.auth.uid || existing().driverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.driverId == request.auth.uid ||
                      isAdmin());
      allow create: if isVerifiedDriver() &&
                       isValidId(offerId) &&
                       incoming().driverId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       isValidRideOffer(incoming()) &&
                       exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
                       get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status == 'searching' &&
                       get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.customerId == incoming().customerId &&
                       incoming().proposedFareInr >= get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.minPermittedFareInr &&
                       incoming().proposedFareInr <= get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.maxPermittedFareInr;
      allow update: if isSignedIn() &&
                       isValidId(offerId) &&
                       isValidRideOffer(incoming()) &&
                       incoming().bookingId == existing().bookingId &&
                       incoming().customerId == existing().customerId &&
                       incoming().driverId == existing().driverId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (request.auth.uid == existing().customerId &&
                          existing().status == 'pending' &&
                          incoming().status in ['accepted', 'rejected'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                         (request.auth.uid == existing().driverId &&
                          existing().status == 'pending' &&
                          incoming().status == 'expired' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                       );
      allow delete: if false;
    }

    // 9. Ride assignments (1 doc per bookingId prevents duplicate driver assignment)
    match /ride_assignments/{assignmentId} {
      allow get: if isSignedIn() && isValidId(assignmentId) &&
                    (existing().customerId == request.auth.uid || existing().driverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.driverId == request.auth.uid ||
                      isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(assignmentId) &&
                       assignmentId == incoming().bookingId &&
                       incoming().customerId == request.auth.uid &&
                       incoming().status == 'active' &&
                       isValidRideAssignment(incoming());
      allow update: if isSignedIn() &&
                       isValidId(assignmentId) &&
                       isValidRideAssignment(incoming()) &&
                       incoming().bookingId == existing().bookingId &&
                       incoming().customerId == existing().customerId &&
                       incoming().driverId == existing().driverId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         ((request.auth.uid == existing().driverId || request.auth.uid == existing().customerId) &&
                          existing().status == 'active' &&
                          incoming().status in ['completed', 'cancelled'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                       );
      allow delete: if false;
    }

    // 10. Live trip driver locations (strictly bound to assigned driver of the booking)
    match /trip_locations/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) &&
                    (existing().customerId == request.auth.uid || existing().driverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.driverId == request.auth.uid ||
                      isAdmin());
      allow create, update: if isSignedIn() &&
                               isValidId(bookingId) &&
                               incoming().bookingId == bookingId &&
                               incoming().driverId == request.auth.uid &&
                               exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
                               get(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedDriverId == request.auth.uid &&
                               isValidTripLocation(incoming());
      allow delete: if isAdmin();
    }

    // 11. Idempotent payment records (keyed by bookingId)
    match /payments/{paymentId} {
      allow get: if isSignedIn() && isValidId(paymentId) &&
                    (existing().customerId == request.auth.uid || existing().driverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.driverId == request.auth.uid ||
                      isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(paymentId) &&
                       paymentId == incoming().bookingId &&
                       (incoming().customerId == request.auth.uid || incoming().driverId == request.auth.uid || isAdmin()) &&
                       (incoming().paymentMethod == 'cash' || incoming().status == 'pending_verification' || isAdmin()) &&
                       isValidPaymentRecord(incoming());
      allow update: if isAdmin() && isValidId(paymentId) && isValidPaymentRecord(incoming());
      allow delete: if false;
    }

    // 12. Commission ledger (idempotent per bookingId, immutable after creation)
    match /commissions/{commissionId} {
      allow get: if isSignedIn() && isValidId(commissionId) &&
                    (existing().driverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(commissionId) &&
                       commissionId == incoming().bookingId &&
                       (incoming().driverId == request.auth.uid || isAdmin()) &&
                       isValidCommissionRecord(incoming());
      allow update, delete: if false;
    }

    // 13. Driver settlement / withdrawal requests (verified drivers only)
    match /driver_settlements/{settlementId} {
      allow get: if isSignedIn() && isValidId(settlementId) &&
                    (existing().driverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isVerifiedDriver() &&
                       isValidId(settlementId) &&
                       incoming().driverId == request.auth.uid &&
                       incoming().status == 'requested' &&
                       isValidDriverSettlement(incoming());
      allow update: if isAdmin() &&
                       isValidId(settlementId) &&
                       isValidDriverSettlement(incoming()) &&
                       incoming().driverId == existing().driverId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // 14. Customer refund requests
    match /refunds/{refundId} {
      allow get: if isSignedIn() && isValidId(refundId) &&
                    (existing().customerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(refundId) &&
                       incoming().customerId == request.auth.uid &&
                       incoming().status == 'requested' &&
                       isValidRefundRecord(incoming());
      allow update: if isAdmin() &&
                       isValidId(refundId) &&
                       isValidRefundRecord(incoming()) &&
                       incoming().customerId == existing().customerId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // 15. Ride ratings
    match /ratings/{ratingId} {
      allow get: if isSignedIn() && isValidId(ratingId);
      allow list: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.driverId == request.auth.uid ||
                      isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(ratingId) &&
                       ratingId == incoming().bookingId &&
                       incoming().customerId == request.auth.uid &&
                       isValidRatingRecord(incoming());
      allow update, delete: if false;
    }

    // 16. Complaints
    match /complaints/{complaintId} {
      allow get: if isSignedIn() && isValidId(complaintId) &&
                    (existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(complaintId) &&
                       incoming().reporterId == request.auth.uid &&
                       incoming().status == 'open' &&
                       isValidComplaintRecord(incoming());
      allow update: if isAdmin() &&
                       isValidId(complaintId) &&
                       isValidComplaintRecord(incoming());
      allow delete: if false;
    }

    // 17. Emergency SOS events
    match /emergency_events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId) &&
                    (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(eventId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'active' &&
                       isValidEmergencyEvent(incoming());
      allow update: if isAdmin() &&
                       isValidId(eventId) &&
                       isValidEmergencyEvent(incoming());
      allow delete: if false;
    }

    // 18. Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) &&
                    (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(notificationId) &&
                       (incoming().userId == request.auth.uid || isAdmin()) &&
                       isValidNotification(incoming());
      allow update: if isSignedIn() &&
                       isValidId(notificationId) &&
                       existing().userId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
                       incoming().read is bool;
      allow delete: if isAdmin();
    }

    // 19. Support, community transport, privacy & account deletion requests
    match /support_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) &&
                    (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'submitted' &&
                       isValidSupportRequest(incoming());
      allow update: if isAdmin() &&
                       isValidId(requestId) &&
                       isValidSupportRequest(incoming());
      allow delete: if false;
    }

    // 20. Immutable admin audit logs
    match /audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    // 21. Admin role allowlist (Bootstrapped admin manages secondary admins)
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isBootstrappedAdmin();
    }

    // 22. Global platform settings (signed-in read, admin-only write)
    match /platform_settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(settingId) && isValidPlatformSettings(incoming());
      allow delete: if false;
    }
  }
}
