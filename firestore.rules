rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isValidPhoneId(phoneE164) {
      return phoneE164 is string && phoneE164.size() >= 8 && phoneE164.size() <= 20 && phoneE164.matches('^\\+[1-9][0-9]{7,15}$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
             'email_verified' in request.auth.token &&
             request.auth.token.email_verified == true &&
             'email' in request.auth.token &&
             request.auth.token.email == 'renukadas083@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
             (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isAuthorizedEmergencyPersonnel() {
      return isAdmin() ||
             (isSignedIn() && exists(/databases/$(database)/documents/emergency_personnel/$(request.auth.uid)));
    }

    function isOperationsStaff() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/operations_staff/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/operations_staff/$(request.auth.uid)).data.isActive == true;
    }

    function isStaffOrAdmin() {
      return isAdmin() || isOperationsStaff();
    }

    function isAuthorizedTestCustomer() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTestCustomer == true;
    }

    function isApprovedTestRider() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/test_riders/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/test_riders/$(request.auth.uid)).data.status == 'approved';
    }

    function isPhoneAuthUser() {
      return isSignedIn() &&
             'phone_number' in request.auth.token &&
             request.auth.token.phone_number is string;
    }

    function verifiedPhone() {
      return request.auth.token.phone_number;
    }

    function isAllowlistedSamplePhone() {
      return isPhoneAuthUser() &&
             exists(/databases/$(database)/documents/sample_rider_allowlist/$(verifiedPhone())) &&
             get(/databases/$(database)/documents/sample_rider_allowlist/$(verifiedPhone())).data.enabled == true;
    }

    function isActiveSampleRider() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/sample_riders/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/sample_riders/$(request.auth.uid)).data.isSampleRider == true &&
             get(/databases/$(database)/documents/sample_riders/$(request.auth.uid)).data.accountType == 'sample' &&
             get(/databases/$(database)/documents/sample_riders/$(request.auth.uid)).data.verificationStatus == 'sample_approved';
    }

    function hasNoPlaintextOtpKeys(data) {
      return !('otp' in data) &&
             !('otpPlaintext' in data) &&
             !('tripPin' in data) &&
             !('code' in data) &&
             !('pin' in data);
    }

    function isAuthorizedTestPartnerId(driverId) {
      return driverId is string &&
             driverId.size() >= 1 &&
             (driverId.matches('^test_driver_.*') ||
              (exists(/databases/$(database)/documents/driver_profiles/$(driverId)) &&
               get(/databases/$(database)/documents/driver_profiles/$(driverId)).data.verificationStatus == 'verified' &&
               get(/databases/$(database)/documents/driver_profiles/$(driverId)).data.isTestPartner == true) ||
              (exists(/databases/$(database)/documents/test_riders/$(driverId)) &&
               get(/databases/$(database)/documents/test_riders/$(driverId)).data.status == 'approved'));
    }

    function isVerifiedDriver() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/driver_profiles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/driver_profiles/$(request.auth.uid)).data.verificationStatus == 'verified';
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    // --- Validation Helpers ---
    function isValidUserAccount(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             (!('uid' in data) || (data.uid is string && data.uid == data.userId)) &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             data.role in ['customer', 'driver', 'rider', 'admin'] &&
             data.preferredLanguage in ['en', 'bn', 'hi'] &&
             data.accountStatus in ['active', 'restricted', 'deletion_requested'] &&
             (!('accountType' in data) || data.accountType in ['commercial', 'sample']) &&
             (!('isSampleRider' in data) || data.isSampleRider is bool) &&
             (!('verificationStatus' in data) || data.verificationStatus in ['', 'pending', 'verified', 'rejected', 'suspended', 'sample_approved', 'revoked']) &&
             (!('availabilityStatus' in data) || data.availabilityStatus in ['offline', 'online']) &&
             isOptionalString(data, 'email', 150) &&
             isOptionalString(data, 'phone', 25) &&
             isOptionalString(data, 'mobileNumber', 25) &&
             isOptionalString(data, 'photoUrl', 500) &&
             (!('lowNetworkMode' in data) || data.lowNetworkMode is bool) &&
             (!('privacyConsentAccepted' in data) || data.privacyConsentAccepted is bool) &&
             (!('profileCompleted' in data) || data.profileCompleted is bool) &&
             (!('emailVerified' in data) || data.emailVerified is bool) &&
             (!('mobileVerified' in data) || data.mobileVerified is bool) &&
             (!('hasEmergencyContact' in data) || data.hasEmergencyContact is bool) &&
             (!('isTestCustomer' in data) || data.isTestCustomer is bool) &&
             (!('accountCreatedAt' in data) || isValidTimestamp(data.accountCreatedAt)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPrivateEmergencyContact(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.emergencyContactNumber is string &&
             data.emergencyContactNumber.size() >= 8 &&
             data.emergencyContactNumber.size() <= 25 &&
             isOptionalString(data, 'relationshipNote', 80) &&
             (!('contacts' in data) || (data.contacts is list && data.contacts.size() >= 1 && data.contacts.size() <= 5)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCustomerProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             isOptionalString(data, 'homeAddress', 240) &&
             isOptionalString(data, 'workAddress', 240) &&
             isOptionalString(data, 'nativeVillage', 120) &&
             isOptionalString(data, 'nativeDistrict', 80) &&
             isOptionalString(data, 'emergencyContactName', 100) &&
             isOptionalString(data, 'emergencyContactPhone', 25) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDriverProfile(data) {
      return data.driverId is string && data.driverId.size() <= 128 &&
             data.legalName is string && data.legalName.size() >= 2 && data.legalName.size() <= 100 &&
             data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 25 &&
             data.district is string && data.district.size() >= 2 && data.district.size() <= 80 &&
             isOptionalString(data, 'address', 240) &&
             isOptionalString(data, 'block', 80) &&
             data.vehicleCategory in ['bike', 'auto', 'toto', 'cab'] &&
             isOptionalString(data, 'vehicleModel', 80) &&
             data.vehicleRegNumber is string && data.vehicleRegNumber.size() >= 4 && data.vehicleRegNumber.size() <= 30 &&
             data.drivingLicenceNumber is string && data.drivingLicenceNumber.size() >= 4 && data.drivingLicenceNumber.size() <= 40 &&
             isOptionalString(data, 'rcNumber', 40) &&
             isOptionalString(data, 'insuranceNumber', 60) &&
             isOptionalString(data, 'permitInfo', 120) &&
             isOptionalString(data, 'settlementUpiOrBank', 100) &&
             isOptionalString(data, 'documentPhotoUri', 500) &&
             isOptionalString(data, 'pucNumber', 60) &&
             isOptionalString(data, 'fitnessCertificateNumber', 60) &&
             (!('dlExpiryEpochDay' in data) || data.dlExpiryEpochDay is int) &&
             (!('rcExpiryEpochDay' in data) || data.rcExpiryEpochDay is int) &&
             (!('insuranceExpiryEpochDay' in data) || data.insuranceExpiryEpochDay is int) &&
             (!('permitExpiryEpochDay' in data) || data.permitExpiryEpochDay is int) &&
             (!('fitnessExpiryEpochDay' in data) || data.fitnessExpiryEpochDay is int) &&
             (!('pucExpiryEpochDay' in data) || data.pucExpiryEpochDay is int) &&
             isOptionalString(data, 'dlPhotoUri', 500) &&
             isOptionalString(data, 'rcPhotoUri', 500) &&
             isOptionalString(data, 'insurancePhotoUri', 500) &&
             isOptionalString(data, 'permitPhotoUri', 500) &&
             isOptionalString(data, 'fitnessPhotoUri', 500) &&
             isOptionalString(data, 'pucPhotoUri', 500) &&
             isOptionalString(data, 'reviewedBy', 128) &&
             isOptionalString(data, 'reviewNote', 300) &&
             (!('verificationVersion' in data) || data.verificationVersion is int) &&
             data.verificationStatus in ['pending', 'verified', 'rejected', 'suspended'] &&
             isOptionalString(data, 'rejectionReason', 300) &&
             data.isOnline is bool &&
             (!('isTestPartner' in data) || data.isTestPartner is bool) &&
              (!('ratingAvg' in data) || (data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5)) &&
              (!('completedRides' in data) || (data.completedRides is int && data.completedRides >= 0)) &&
              isOptionalString(data, 'emergencyContactName', 100) &&
              isOptionalString(data, 'emergencyContactPhone', 25) &&
              isOptionalString(data, 'policeVerificationNumber', 60) &&
              isOptionalString(data, 'alternateIdType', 40) &&
              isOptionalString(data, 'alternateIdLast4', 10) &&
              isOptionalString(data, 'operatingState', 20) &&
              isOptionalString(data, 'welfareInsurancePolicyNo', 60) &&
              (!('driverTrainingCompleted' in data) || data.driverTrainingCompleted is bool) &&
              (!('complianceTermsAccepted' in data) || data.complianceTermsAccepted is bool) &&
              isValidTimestamp(data.createdAt) &&
              isValidTimestamp(data.updatedAt);
    }

    function isValidDriverDirectory(data) {
      return data.driverId is string && data.driverId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.vehicleCategory in ['bike', 'auto', 'toto', 'cab'] &&
             isOptionalString(data, 'vehicleModel', 80) &&
             isOptionalString(data, 'maskedPlate', 30) &&
             data.district is string && data.district.size() <= 80 &&
             isOptionalString(data, 'block', 80) &&
             data.verificationStatus in ['pending', 'verified', 'rejected', 'suspended'] &&
             data.isOnline is bool &&
             (!('isTestPartner' in data) || data.isTestPartner is bool) &&
             (!('currentLat' in data) || data.currentLat is number) &&
             (!('currentLng' in data) || data.currentLng is number) &&
             (!('ratingAvg' in data) || data.ratingAvg is number) &&
             (!('completedRides' in data) || data.completedRides is int) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidServiceArea(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
             isOptionalString(data, 'nameBn', 120) &&
             data.district is string && data.district.size() >= 2 && data.district.size() <= 80 &&
             isOptionalString(data, 'block', 80) &&
             data.zoneType in ['railway_station', 'bus_stand', 'airport', 'village', 'hospital', 'market', 'town'] &&
             (!('lat' in data) || data.lat is number) &&
             (!('lng' in data) || data.lng is number) &&
             data.isActive is bool &&
             (!('parcelApproved' in data) || data.parcelApproved is bool) &&
             isOptionalString(data, 'operationalHours', 60) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFareConfig(data) {
      return data.vehicleCategory in ['bike', 'auto', 'toto', 'cab', 'outstation', 'scheduled', 'parcel'] &&
             data.version is int && data.version >= 1 &&
             data.baseFareInr is number && data.baseFareInr >= 0 &&
             data.perKmRateInr is number && data.perKmRateInr >= 0 &&
             data.minimumFareInr is number && data.minimumFareInr >= 0 &&
             (!('waitingChargePerMinInr' in data) || data.waitingChargePerMinInr is number) &&
             (!('cancellationFeeInr' in data) || data.cancellationFeeInr is number) &&
             data.gstPercent is number && data.gstPercent >= 0 && data.gstPercent <= 28 &&
             data.commissionPercent is number && data.commissionPercent >= 0 && data.commissionPercent <= 40 &&
             data.allowDriverFareProposal is bool &&
             (!('minBidFactor' in data) || (data.minBidFactor is number && data.minBidFactor >= 0.7 && data.minBidFactor <= 1.0)) &&
             (!('maxBidFactor' in data) || (data.maxBidFactor is number && data.maxBidFactor >= 1.0 && data.maxBidFactor <= 1.5)) &&
             data.isEnabled is bool &&
             isOptionalString(data, 'updatedBy', 128) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBooking(data) {
      return data.customerId is string && data.customerId.size() <= 128 &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
             (!('bookingChannel' in data) || data.bookingChannel in ['app', 'community_center']) &&
             data.bookingType in [
               'now', 'scheduled', 'station_pickup', 'bus_stand_pickup',
               'airport_transfer', 'village_to_town', 'native_village', 'family', 'return_trip'
             ] &&
             data.vehicleCategory in ['bike', 'auto', 'toto', 'cab', 'outstation', 'scheduled', 'parcel'] &&
             data.pickupLabel is string && data.pickupLabel.size() >= 1 && data.pickupLabel.size() <= 200 &&
             isOptionalString(data, 'pickupDistrict', 80) &&
             (!('pickupLat' in data) || data.pickupLat is number) &&
             (!('pickupLng' in data) || data.pickupLng is number) &&
             data.destinationLabel is string && data.destinationLabel.size() >= 1 && data.destinationLabel.size() <= 200 &&
             isOptionalString(data, 'destinationDistrict', 80) &&
             (!('destinationLat' in data) || data.destinationLat is number) &&
             (!('destinationLng' in data) || data.destinationLng is number) &&
             data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 2000 &&
             (!('estimatedDurationMin' in data) || (data.estimatedDurationMin is int && data.estimatedDurationMin >= 0)) &&
             data.estimatedFareInr is number && data.estimatedFareInr >= 0 &&
             data.minPermittedFareInr is number && data.minPermittedFareInr >= 0 &&
             data.maxPermittedFareInr is number && data.maxPermittedFareInr >= data.minPermittedFareInr &&
             (!('agreedFareInr' in data) || data.agreedFareInr is number) &&
             (!('fareConfigVersion' in data) || data.fareConfigVersion is int) &&
             (!('commissionPercent' in data) || data.commissionPercent is number) &&
             (!('gstPercent' in data) || data.gstPercent is number) &&
             data.paymentMethod in ['cash', 'upi'] &&
             data.paymentStatus in ['pending', 'pending_verification', 'settled_cash', 'paid', 'refunded'] &&
             data.status in ['searching', 'assigned', 'arriving', 'arrived', 'in_progress', 'completed', 'cancelled'] &&
             isOptionalString(data, 'assignedDriverId', 128) &&
             isOptionalString(data, 'assignedDriverName', 100) &&
             isOptionalString(data, 'assignedVehicleLabel', 100) &&
             isOptionalString(data, 'acceptedOfferId', 128) &&
             isOptionalString(data, 'tripPin', 10) &&
             isOptionalString(data, 'trainNumber', 30) &&
             isOptionalString(data, 'scheduledDateTimeLabel', 80) &&
             isOptionalString(data, 'familyMemberName', 100) &&
             (!('familyConsentConfirmed' in data) || data.familyConsentConfirmed is bool) &&
             (!('isRoundTrip' in data) || data.isRoundTrip is bool) &&
             isOptionalString(data, 'cancellationReason', 250) &&
             isOptionalString(data, 'cancelledBy', 128) &&
             (!('cancelledByRole' in data) || data.cancelledByRole in ['', 'customer', 'driver', 'admin', 'ops_staff']) &&
             isOptionalString(data, 'cancellationCategory', 120) &&
             isOptionalString(data, 'invoiceEmail', 150) &&
             (!('customerRating' in data) || (data.customerRating is int && data.customerRating >= 1 && data.customerRating <= 5)) &&
             (!('customerFeedbackRating' in data) || (data.customerFeedbackRating is int && data.customerFeedbackRating >= 1 && data.customerFeedbackRating <= 5)) &&
             isOptionalString(data, 'customerFeedbackNote', 300) &&
             (!('is_test_ride' in data) || data.is_test_ride is bool) &&
             (!('test_mode' in data) || data.test_mode is bool) &&
             isOptionalString(data, 'test_otp_status', 40) &&
             (!('test_otp_expires_at_ms' in data) || (data.test_otp_expires_at_ms is int && data.test_otp_expires_at_ms >= 0)) &&
             isOptionalString(data, 'otp_status', 40) &&
             (!('otp_expires_at_ms' in data) || (data.otp_expires_at_ms is int && data.otp_expires_at_ms >= 0)) &&
             (!('requestExpiresAtMs' in data) || (data.requestExpiresAtMs is int && data.requestExpiresAtMs >= 0)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBookingUpdate(data) {
      return data.status in ['searching', 'assigned', 'arriving', 'arrived', 'in_progress', 'completed', 'cancelled'] &&
             data.paymentStatus in ['pending', 'pending_verification', 'settled_cash', 'paid', 'refunded'] &&
             (!('agreedFareInr' in data) || (data.agreedFareInr is number && data.agreedFareInr >= 0)) &&
             (!('assignedDriverId' in data) || (data.assignedDriverId is string && data.assignedDriverId.size() <= 128)) &&
             (!('assignedDriverName' in data) || (data.assignedDriverName is string && data.assignedDriverName.size() <= 100)) &&
             (!('assignedVehicleLabel' in data) || (data.assignedVehicleLabel is string && data.assignedVehicleLabel.size() <= 100)) &&
             (!('acceptedOfferId' in data) || (data.acceptedOfferId is string && data.acceptedOfferId.size() <= 128)) &&
             (!('tripPin' in data) || (data.tripPin is string && data.tripPin.size() <= 10)) &&
             (!('cancellationReason' in data) || (data.cancellationReason is string && data.cancellationReason.size() <= 250)) &&
             (!('cancelledBy' in data) || (data.cancelledBy is string && data.cancelledBy.size() <= 128)) &&
             (!('cancelledByRole' in data) || data.cancelledByRole in ['', 'customer', 'driver', 'admin', 'ops_staff']) &&
             (!('cancellationCategory' in data) || (data.cancellationCategory is string && data.cancellationCategory.size() <= 120)) &&
             (!('customerRating' in data) || (data.customerRating is int && data.customerRating >= 1 && data.customerRating <= 5)) &&
             (!('customerFeedbackRating' in data) || (data.customerFeedbackRating is int && data.customerFeedbackRating >= 1 && data.customerFeedbackRating <= 5)) &&
             (!('customerFeedbackNote' in data) || (data.customerFeedbackNote is string && data.customerFeedbackNote.size() <= 300)) &&
             (!('test_otp_status' in data) || (data.test_otp_status is string && data.test_otp_status.size() <= 40)) &&
             (!('test_otp_expires_at_ms' in data) || (data.test_otp_expires_at_ms is int && data.test_otp_expires_at_ms >= 0)) &&
             (!('otp_status' in data) || (data.otp_status is string && data.otp_status.size() <= 40)) &&
             (!('otp_expires_at_ms' in data) || (data.otp_expires_at_ms is int && data.otp_expires_at_ms >= 0)) &&
             (!('requestExpiresAtMs' in data) || (data.requestExpiresAtMs is int && data.requestExpiresAtMs >= 0)) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRideOffer(data) {
      return data.bookingId is string && isValidId(data.bookingId) &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.driverName is string && data.driverName.size() >= 1 && data.driverName.size() <= 100 &&
             data.vehicleCategory in ['bike', 'auto', 'toto', 'cab', 'outstation', 'scheduled', 'parcel'] &&
             isOptionalString(data, 'vehicleLabel', 100) &&
             (!('driverRating' in data) || data.driverRating is number) &&
             (!('driverCompletedRides' in data) || data.driverCompletedRides is int) &&
             (!('isVerifiedDriver' in data) || data.isVerifiedDriver is bool) &&
             data.etaMinutes is int && data.etaMinutes >= 1 && data.etaMinutes <= 240 &&
             data.proposedFareInr is number && data.proposedFareInr >= 1 &&
             data.status in ['pending', 'accepted', 'rejected', 'expired'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRideAssignment(data) {
      return data.bookingId is string && isValidId(data.bookingId) &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             isOptionalString(data, 'offerId', 128) &&
             data.lockedFareInr is number && data.lockedFareInr >= 1 &&
             data.status in ['active', 'completed', 'cancelled'] &&
             (!('is_test_ride' in data) || data.is_test_ride is bool) &&
             isOptionalString(data, 'assignedByUid', 128) &&
             (!('assignedByRole' in data) || data.assignedByRole in ['', 'customer', 'driver', 'admin', 'ops_staff']) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTripLocation(data) {
      return data.bookingId is string && isValidId(data.bookingId) &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.lat is number && data.lng is number &&
             (!('isTestRide' in data) || data.isTestRide is bool) &&
             (!('isSimulated' in data) || data.isSimulated is bool) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidLiveLocation(data, locationId) {
      return data.driverId == locationId &&
             data.driverId is string && data.driverId.size() >= 1 && data.driverId.size() <= 128 &&
             data.bookingId is string && isValidId(data.bookingId) &&
             data.customerId is string && data.customerId.size() >= 1 && data.customerId.size() <= 128 &&
             data.lat is number && data.lng is number &&
             (!('headingDeg' in data) || data.headingDeg is number) &&
             (!('speedKmph' in data) || data.speedKmph is number) &&
             data.isTestRide is bool &&
             data.isSimulated is bool &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPaymentRecord(data) {
      return data.bookingId is string && isValidId(data.bookingId) &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.grossFareInr is number && data.grossFareInr >= 0 &&
             data.gstInr is number && data.gstInr >= 0 &&
             data.platformCommissionInr is number && data.platformCommissionInr >= 0 &&
             data.netDriverEarningsInr is number && data.netDriverEarningsInr >= 0 &&
             data.paymentMethod in ['cash', 'upi'] &&
             isOptionalString(data, 'invoiceEmail', 150) &&
             isOptionalString(data, 'gatewayReference', 128) &&
             data.status in ['settled_cash', 'pending_verification', 'paid', 'refunded'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCommissionRecord(data) {
      return data.bookingId is string && isValidId(data.bookingId) &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.grossFareInr is number && data.grossFareInr >= 0 &&
             data.commissionRatePct is number && data.commissionRatePct >= 0 && data.commissionRatePct <= 40 &&
             data.commissionAmountInr is number && data.commissionAmountInr >= 0 &&
             data.netDriverEarningsInr is number && data.netDriverEarningsInr >= 0 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidDriverSettlement(data) {
      return data.driverId is string && data.driverId.size() <= 128 &&
             data.driverName is string && data.driverName.size() >= 1 && data.driverName.size() <= 100 &&
             data.amountInr is number && data.amountInr >= 50 && data.amountInr <= 100000 &&
             data.upiOrBankRef is string && data.upiOrBankRef.size() >= 3 && data.upiOrBankRef.size() <= 100 &&
             data.status in ['requested', 'processing', 'paid', 'rejected'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRefundRecord(data) {
      return data.bookingId is string && isValidId(data.bookingId) &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.amountInr is number && data.amountInr >= 1 &&
             data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 300 &&
             data.status in ['requested', 'approved', 'processed', 'rejected'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRatingRecord(data) {
      return data.bookingId is string && isValidId(data.bookingId) &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.stars is int && data.stars >= 1 && data.stars <= 5 &&
             (!('driverBehaviorRating' in data) || (data.driverBehaviorRating is int && data.driverBehaviorRating >= 1 && data.driverBehaviorRating <= 5)) &&
             (!('vehicleConditionRating' in data) || (data.vehicleConditionRating is int && data.vehicleConditionRating >= 1 && data.vehicleConditionRating <= 5)) &&
             (!('punctualityRating' in data) || (data.punctualityRating is int && data.punctualityRating >= 1 && data.punctualityRating <= 5)) &&
             (!('safetyRating' in data) || (data.safetyRating is int && data.safetyRating >= 1 && data.safetyRating <= 5)) &&
             isOptionalString(data, 'review', 300) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidComplaintRecord(data) {
      return data.reporterId is string && data.reporterId.size() <= 128 &&
             isOptionalString(data, 'bookingId', 128) &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 80 &&
             data.description is string && data.description.size() >= 5 && data.description.size() <= 500 &&
             data.status in ['open', 'investigating', 'resolved'] &&
             isOptionalString(data, 'resolutionNote', 300) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidEmergencyEvent(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             isOptionalString(data, 'bookingId', 128) &&
             (!('lat' in data) || data.lat is number) &&
             (!('lng' in data) || data.lng is number) &&
             isOptionalString(data, 'emergencyContactRef', 160) &&
             data.notes is string && data.notes.size() >= 2 && data.notes.size() <= 300 &&
             data.status in ['active', 'acknowledged', 'resolved'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNotification(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 300 &&
             data.type is string && data.type.size() >= 1 && data.type.size() <= 50 &&
             isOptionalString(data, 'bookingId', 128) &&
             isOptionalString(data, 'entityId', 128) &&
             isOptionalString(data, 'targetApp', 30) &&
             isOptionalString(data, 'targetScreen', 64) &&
             (!('isTestRide' in data) || data.isTestRide is bool) &&
             data.read is bool &&
             isValidTimestamp(data.createdAt);
    }

    function isValidSupportRequest(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.requestType in ['community_booking', 'account_deletion', 'privacy_inquiry', 'general_support'] &&
             data.details is string && data.details.size() >= 3 && data.details.size() <= 500 &&
             data.status in ['submitted', 'in_review', 'completed'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAuditLog(data) {
      return data.actorId is string && data.actorId.size() <= 128 &&
             isOptionalString(data, 'actorEmail', 150) &&
             data.action is string && data.action.size() >= 2 && data.action.size() <= 80 &&
             data.targetCollection is string && data.targetCollection.size() >= 2 && data.targetCollection.size() <= 80 &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 300 &&
             (!('isTestRide' in data) || data.isTestRide is bool) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidPlatformSettings(data) {
      return isOptionalString(data, 'helplineNumber', 30) &&
             (!('parcelDeliveryEnabled' in data) || data.parcelDeliveryEnabled is bool) &&
             isOptionalString(data, 'maintenanceNotice', 300) &&
             isOptionalString(data, 'cancellationPolicySummary', 400) &&
             (!('defaultCommissionPct' in data) || (data.defaultCommissionPct is number && data.defaultCommissionPct >= 0 && data.defaultCommissionPct <= 40)) &&
             (!('updatesEnabled' in data) || data.updatesEnabled is bool) &&
             isOptionalString(data, 'latestVersionName', 32) &&
             (!('latestVersionCode' in data) || (data.latestVersionCode is int && data.latestVersionCode >= 1)) &&
             (!('minSupportedVersionCode' in data) || (data.minSupportedVersionCode is int && data.minSupportedVersionCode >= 1)) &&
             isOptionalString(data, 'apkDownloadUrl', 500) &&
             isOptionalString(data, 'sha256Checksum', 64) &&
             isOptionalString(data, 'releaseNotes', 1000) &&
             (!('isMandatoryUpdate' in data) || data.isMandatoryUpdate is bool) &&
             isOptionalString(data, 'updateManifestUrl', 500) &&
             (!('testRideModeEnabled' in data) || data.testRideModeEnabled is bool) &&
             (!('testAutoAssignEnabled' in data) || data.testAutoAssignEnabled is bool) &&
             (!('testManualAssignEnabled' in data) || data.testManualAssignEnabled is bool) &&
             (!('testDriverSpeedKmph' in data) || (data.testDriverSpeedKmph is number && data.testDriverSpeedKmph >= 5 && data.testDriverSpeedKmph <= 120)) &&
             (!('testOtpValiditySeconds' in data) || (data.testOtpValiditySeconds is int && data.testOtpValiditySeconds >= 60 && data.testOtpValiditySeconds <= 1800)) &&
             (!('testAllowAdminOtpOverride' in data) || data.testAllowAdminOtpOverride is bool) &&
             (!('testAutoCompleteEnabled' in data) || data.testAutoCompleteEnabled is bool) &&
             isOptionalString(data, 'operatingStateCode', 12) &&
             isOptionalString(data, 'aggregatorLicenceNumber', 80) &&
             isOptionalString(data, 'grievanceOfficerName', 100) &&
             isOptionalString(data, 'grievanceOfficerEmail', 150) &&
             (!('bikeTaxiCommercialApproved' in data) || data.bikeTaxiCommercialApproved is bool) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTestRideOtpChallenge(data, bookingId) {
      return data.bookingId == bookingId &&
             data.customerId is string && data.customerId.size() >= 1 && data.customerId.size() <= 128 &&
             data.otpHash is string && data.otpHash.size() == 64 &&
             isOptionalString(data, 'submittedHash', 64) &&
             data.used is bool &&
             data.overridden is bool &&
             isOptionalString(data, 'overrideReason', 250) &&
             isOptionalString(data, 'overrideRequestedByUid', 128) &&
             isOptionalString(data, 'overrideRequestedReason', 250) &&
             (!('overrideRequestedAt' in data) || data.overrideRequestedAt == null || data.overrideRequestedAt is timestamp) &&
             isOptionalString(data, 'overriddenByUid', 128) &&
             isOptionalString(data, 'verifiedByUid', 128) &&
             data.attempts is int && data.attempts >= 0 &&
             data.maxAttempts is int && data.maxAttempts >= 1 && data.maxAttempts <= 10 &&
             (!('lastAttemptAtMs' in data) || (data.lastAttemptAtMs is int && data.lastAttemptAtMs >= 0)) &&
             data.expiresAt is timestamp &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTestRideOtpSecret(data, bookingId) {
      return data.bookingId == bookingId &&
             data.customerId is string && data.customerId.size() >= 1 && data.customerId.size() <= 128 &&
             data.otpPlaintext is string && data.otpPlaintext.size() == 6 &&
             data.status in ['pending', 'verified', 'overridden', 'expired', 'reset'] &&
             isOptionalString(data, 'issuedByUid', 128) &&
             isOptionalString(data, 'issuedByRole', 30) &&
             data.expiresAt is timestamp &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTestRiderRequest(data) {
      return data.uid is string && isValidId(data.uid) &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.mobileNumber is string && data.mobileNumber.size() >= 8 && data.mobileNumber.size() <= 25 &&
             isOptionalString(data, 'email', 150) &&
             data.vehicleCategory in ['bike', 'auto', 'toto', 'cab'] &&
             data.testPurpose is string && data.testPurpose.size() >= 4 && data.testPurpose.size() <= 300 &&
             isOptionalString(data, 'notes', 400) &&
             data.status in ['pending', 'approved', 'rejected', 'suspended', 'revoked'] &&
             isOptionalString(data, 'rejectionReason', 300) &&
             isOptionalString(data, 'reviewedByUid', 128) &&
             isOptionalString(data, 'reviewedByRole', 40) &&
             isOptionalString(data, 'reviewNote', 300) &&
             isOptionalString(data, 'opsRecommendation', 40) &&
             isOptionalString(data, 'opsRecommendedByUid', 128) &&
             isOptionalString(data, 'opsRecommendedNote', 300) &&
             isOptionalString(data, 'deviceInfoSummary', 200) &&
             (!('isOnline' in data) || data.isOnline is bool) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTestRiderProfile(data) {
      return data.uid is string && isValidId(data.uid) &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
             isOptionalString(data, 'mobileNumber', 25) &&
             data.vehicleCategory in ['bike', 'auto', 'toto', 'cab'] &&
             isOptionalString(data, 'vehicleLabel', 100) &&
             data.status in ['approved', 'suspended', 'revoked'] &&
             data.isOnline is bool &&
             (!('currentLat' in data) || data.currentLat is number) &&
             (!('currentLng' in data) || data.currentLng is number) &&
             (!('completedTestRides' in data) || (data.completedTestRides is int && data.completedTestRides >= 0)) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTestRiderAuditLog(data) {
      return data.targetUid is string && isValidId(data.targetUid) &&
             data.actorUid is string && isValidId(data.actorUid) &&
             data.actorRole is string && data.actorRole.size() >= 2 && data.actorRole.size() <= 40 &&
             data.action is string && data.action.size() >= 2 && data.action.size() <= 80 &&
             isOptionalString(data, 'previousStatus', 40) &&
             data.newStatus in ['pending', 'approved', 'rejected', 'suspended', 'revoked'] &&
             isOptionalString(data, 'reason', 300) &&
             isOptionalString(data, 'note', 300) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidOperationsStaff(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
             isOptionalString(data, 'contactIdentifier', 100) &&
             data.assignedDistrict is string && data.assignedDistrict.size() >= 2 && data.assignedDistrict.size() <= 80 &&
             data.isActive is bool &&
             isOptionalString(data, 'grantedBy', 128) &&
             isOptionalString(data, 'grantedByEmail', 150) &&
             isOptionalString(data, 'revokedBy', 128) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSampleRiderAllowlist(data, phoneE164) {
      return data.phoneE164 == phoneE164 &&
             isValidPhoneId(data.phoneE164) &&
             data.enabled is bool &&
             isOptionalString(data, 'label', 100) &&
             (!('vehicleCategory' in data) || data.vehicleCategory in ['bike', 'auto', 'toto', 'cab']) &&
             isOptionalString(data, 'addedByUid', 128) &&
             isOptionalString(data, 'note', 300) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSampleRiderProfile(data) {
      return data.uid is string && isValidId(data.uid) &&
             data.role == 'rider' &&
             data.accountType == 'sample' &&
             data.isSampleRider is bool &&
             data.verificationStatus in ['sample_approved', 'suspended', 'revoked'] &&
             data.availabilityStatus in ['offline', 'online'] &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 25 &&
             isOptionalString(data, 'photoUrl', 500) &&
             data.vehicleCategory in ['bike', 'auto', 'toto', 'cab'] &&
             isOptionalString(data, 'emergencyContactName', 100) &&
             isOptionalString(data, 'emergencyContactPhone', 25) &&
             (!('currentLat' in data) || data.currentLat == null || data.currentLat is number) &&
             (!('currentLng' in data) || data.currentLng == null || data.currentLng is number) &&
             (!('locationUpdatedAt' in data) || data.locationUpdatedAt == null || data.locationUpdatedAt is timestamp) &&
             (!('completedSampleRides' in data) || (data.completedSampleRides is int && data.completedSampleRides >= 0)) &&
             (!('totalSampleEarningsInr' in data) || (data.totalSampleEarningsInr is number && data.totalSampleEarningsInr >= 0)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSampleRide(data, rideId) {
      return data.rideId == rideId &&
             data.isSample == true &&
             data.customerId is string && isValidId(data.customerId) &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
             isOptionalString(data, 'createdByUid', 128) &&
             isOptionalString(data, 'createdByRole', 30) &&
             data.vehicleCategory in ['bike', 'auto', 'toto', 'cab'] &&
             data.pickupLabel is string && data.pickupLabel.size() >= 1 && data.pickupLabel.size() <= 200 &&
             data.pickupLat is number && data.pickupLng is number &&
             data.destinationLabel is string && data.destinationLabel.size() >= 1 && data.destinationLabel.size() <= 200 &&
             data.destinationLat is number && data.destinationLng is number &&
             data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 2000 &&
             (!('estimatedDurationMin' in data) || (data.estimatedDurationMin is int && data.estimatedDurationMin >= 0)) &&
             data.estimatedFareInr is number && data.estimatedFareInr >= 0 &&
             data.status in ['incoming', 'accepted', 'arriving', 'arrived', 'in_progress', 'completed', 'cancelled', 'expired'] &&
             isOptionalString(data, 'assignedSampleRiderId', 128) &&
             isOptionalString(data, 'assignedSampleRiderName', 100) &&
             isOptionalString(data, 'assignedSampleRiderPhone', 25) &&
             data.otpVerified is bool &&
             (!('riderLat' in data) || data.riderLat == null || data.riderLat is number) &&
             (!('riderLng' in data) || data.riderLng == null || data.riderLng is number) &&
             (!('otpVerifiedAt' in data) || data.otpVerifiedAt == null || data.otpVerifiedAt is timestamp) &&
             (!('completedAt' in data) || data.completedAt == null || data.completedAt is timestamp) &&
             data.expiresAt is timestamp &&
             isOptionalString(data, 'cancellationReason', 250) &&
             hasNoPlaintextOtpKeys(data) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSampleRideOtpChallenge(data, rideId) {
      return data.rideId == rideId &&
             data.customerId is string && isValidId(data.customerId) &&
             data.otpHash is string && data.otpHash.size() == 64 &&
             isOptionalString(data, 'submittedHash', 64) &&
             data.used is bool &&
             data.attempts is int && data.attempts >= 0 &&
             data.maxAttempts is int && data.maxAttempts >= 1 && data.maxAttempts <= 10 &&
             (!('lastAttemptAtMs' in data) || (data.lastAttemptAtMs is int && data.lastAttemptAtMs >= 0)) &&
             isOptionalString(data, 'verifiedByUid', 128) &&
             data.expiresAt is timestamp &&
             hasNoPlaintextOtpKeys(data) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- Collection Rules ---

    // 1. User accounts (PII isolated to owner or Admin; self-assigning 'admin' or mutating role blocked; Sample Rider requires allowlisted phone)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().accountStatus == 'active' &&
                       (!('isTestCustomer' in incoming()) || incoming().isTestCustomer == false || isAdmin()) && (
                         isAdmin() ||
                         (incoming().role in ['customer', 'driver'] &&
                          (!('accountType' in incoming()) || incoming().accountType == 'commercial') &&
                          (!('isSampleRider' in incoming()) || incoming().isSampleRider == false) &&
                          (!('verificationStatus' in incoming()) || incoming().verificationStatus != 'sample_approved')) ||
                         (isAllowlistedSamplePhone() &&
                          incoming().role == 'rider' &&
                          incoming().accountType == 'sample' &&
                          incoming().isSampleRider == true &&
                          incoming().verificationStatus == 'sample_approved' &&
                          incoming().availabilityStatus in ['offline', 'online'])
                       ) &&
                       isValidUserAccount(incoming());
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserAccount(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (request.auth.uid == userId &&
                          incoming().role == existing().role &&
                          incoming().accountStatus == existing().accountStatus &&
                          (!('accountType' in incoming()) || !('accountType' in existing()) || incoming().accountType == existing().accountType) &&
                          (!('isSampleRider' in incoming()) || (('isSampleRider' in existing()) && incoming().isSampleRider == existing().isSampleRider) || incoming().isSampleRider == false) &&
                          (!('verificationStatus' in incoming()) || (('verificationStatus' in existing()) && incoming().verificationStatus == existing().verificationStatus) || incoming().verificationStatus != 'sample_approved') &&
                          (!('isTestCustomer' in incoming()) || (('isTestCustomer' in existing()) && incoming().isTestCustomer == existing().isTestCustomer) || incoming().isTestCustomer == false) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'uid', 'fullName', 'email', 'phone', 'mobileNumber', 'photoUrl',
                            'preferredLanguage', 'lowNetworkMode', 'privacyConsentAccepted',
                            'profileCompleted', 'emailVerified', 'mobileVerified',
                            'hasEmergencyContact', 'updatedAt'
                          ])) ||
                         (request.auth.uid == userId &&
                          isAllowlistedSamplePhone() &&
                          incoming().role == 'rider' &&
                          incoming().accountType == 'sample' &&
                          incoming().isSampleRider == true &&
                          incoming().verificationStatus == 'sample_approved' &&
                          incoming().availabilityStatus in ['offline', 'online'] &&
                          incoming().accountStatus == existing().accountStatus &&
                          (!('isTestCustomer' in incoming()) || (('isTestCustomer' in existing()) && incoming().isTestCustomer == existing().isTestCustomer) || incoming().isTestCustomer == false) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'uid', 'fullName', 'email', 'phone', 'mobileNumber', 'photoUrl',
                            'preferredLanguage', 'lowNetworkMode', 'privacyConsentAccepted',
                            'profileCompleted', 'emailVerified', 'mobileVerified',
                            'hasEmergencyContact', 'role', 'accountType', 'isSampleRider',
                            'verificationStatus', 'availabilityStatus', 'updatedAt'
                          ]))
                       );
      allow delete: if isAdmin();
    }

    // 1b. Strictly private emergency contacts (never publicly readable; restricted to owner & authorized emergency personnel)
    match /emergency_contacts/{userId} {
      allow get: if isSignedIn() && isValidId(userId) &&
                    (request.auth.uid == userId || isAuthorizedEmergencyPersonnel());
      allow list: if isAuthorizedEmergencyPersonnel();
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       isValidPrivateEmergencyContact(incoming());
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidPrivateEmergencyContact(incoming());
      allow delete: if isAdmin();
    }

    // 1c. Authorized emergency personnel allowlist (Admin-managed)
    match /emergency_personnel/{personnelUid} {
      allow get: if isSignedIn() && isValidId(personnelUid) &&
                    (request.auth.uid == personnelUid || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    // 2. Customer profiles (PII isolated)
    match /customer_profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       isValidCustomerProfile(incoming());
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidCustomerProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 3. Private driver KYC profiles (owner cannot self-verify)
    match /driver_profiles/{driverId} {
      allow get: if isSignedIn() && isValidId(driverId) && (request.auth.uid == driverId || isAdmin());
      allow list: if isSignedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(driverId) &&
                       request.auth.uid == driverId &&
                       incoming().driverId == request.auth.uid &&
                       incoming().verificationStatus == 'pending' &&
                       incoming().isOnline == false &&
                       (!('isTestPartner' in incoming()) || incoming().isTestPartner == false || isAdmin()) &&
                       isValidDriverProfile(incoming());
      allow update: if isSignedIn() &&
                       isValidId(driverId) &&
                       isValidDriverProfile(incoming()) &&
                       incoming().driverId == existing().driverId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (request.auth.uid == driverId &&
                          (incoming().verificationStatus == existing().verificationStatus ||
                           (existing().verificationStatus == 'rejected' && incoming().verificationStatus == 'pending' && incoming().isOnline == false)) &&
                          incoming().ratingAvg == existing().ratingAvg &&
                          incoming().completedRides == existing().completedRides &&
                          (incoming().isOnline == false || existing().verificationStatus == 'verified') &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'isOnline', 'phone', 'address', 'district', 'block', 'vehicleModel',
                            'drivingLicenceNumber', 'rcNumber', 'insuranceNumber', 'permitInfo',
                            'pucNumber', 'fitnessCertificateNumber',
                            'dlExpiryEpochDay', 'rcExpiryEpochDay', 'insuranceExpiryEpochDay',
                            'permitExpiryEpochDay', 'fitnessExpiryEpochDay', 'pucExpiryEpochDay',
                            'dlPhotoUri', 'rcPhotoUri', 'insurancePhotoUri', 'permitPhotoUri',
                            'fitnessPhotoUri', 'pucPhotoUri', 'verificationStatus', 'rejectionReason',
                            'settlementUpiOrBank', 'documentPhotoUri',
                            'emergencyContactName', 'emergencyContactPhone',
                            'policeVerificationNumber', 'alternateIdType', 'alternateIdLast4',
                            'operatingState', 'welfareInsurancePolicyNo',
                            'driverTrainingCompleted', 'complianceTermsAccepted',
                            'updatedAt'
                          ]))
                       );
      allow delete: if isAdmin();
    }

    // 4. Public verified driver discovery directory (no PII)
    match /driver_directory/{driverId} {
      allow get: if isSignedIn() && isValidId(driverId) &&
                    (existing().verificationStatus == 'verified' || request.auth.uid == driverId || isAdmin() || isOperationsStaff());
      allow list: if isSignedIn() &&
                     (resource.data.verificationStatus == 'verified' ||
                      resource.data.driverId == request.auth.uid ||
                      isAdmin() ||
                      isOperationsStaff());
      allow create: if isSignedIn() &&
                       isValidId(driverId) &&
                       isValidDriverDirectory(incoming()) && (
                         isAdmin() ||
                         (request.auth.uid == driverId &&
                          incoming().driverId == request.auth.uid &&
                          incoming().verificationStatus == 'pending' &&
                          incoming().isOnline == false &&
                          (!('isTestPartner' in incoming()) || incoming().isTestPartner == false))
                       );
      allow update: if isSignedIn() &&
                       isValidId(driverId) &&
                       isValidDriverDirectory(incoming()) &&
                       incoming().driverId == existing().driverId && (
                         isAdmin() ||
                         (request.auth.uid == driverId &&
                          incoming().verificationStatus == existing().verificationStatus &&
                          (incoming().isOnline == false || existing().verificationStatus == 'verified') &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'isOnline', 'currentLat', 'currentLng', 'updatedAt'
                          ]))
                       );
      allow delete: if isAdmin();
    }

    // 5. Service areas (public catalog for signed-in users; Admin managed)
    match /service_areas/{areaId} {
      allow get: if isSignedIn() && isValidId(areaId);
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(areaId) && isValidServiceArea(incoming());
      allow delete: if isAdmin() && isValidId(areaId);
    }

    // 6. Versioned fare configurations (public catalog for signed-in users; Admin managed)
    match /fare_configs/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(configId) && isValidFareConfig(incoming());
      allow delete: if isAdmin() && isValidId(configId);
    }

    // 7. Bookings (searching bookings readable only by verified drivers for non-test rides, approved test riders for test rides, owner, ops staff, or admin)
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) &&
                    (existing().customerId == request.auth.uid ||
                     existing().assignedDriverId == request.auth.uid ||
                     (existing().status == 'searching' && (!('is_test_ride' in existing()) || existing().is_test_ride != true) && isVerifiedDriver()) ||
                     (existing().status == 'searching' && 'is_test_ride' in existing() && existing().is_test_ride == true && isApprovedTestRider()) ||
                     isOperationsStaff() ||
                     isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.assignedDriverId == request.auth.uid ||
                      (resource.data.status == 'searching' && resource.data.is_test_ride == false && isVerifiedDriver()) ||
                      (resource.data.status == 'searching' && resource.data.is_test_ride == true && isApprovedTestRider()) ||
                      isOperationsStaff() ||
                      isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(bookingId) &&
                       incoming().customerId == request.auth.uid &&
                       incoming().status == 'searching' &&
                       incoming().paymentStatus == 'pending' &&
                       (!('is_test_ride' in incoming()) ||
                        incoming().is_test_ride == false ||
                        (incoming().is_test_ride == true &&
                         incoming().test_mode == true &&
                         exists(/databases/$(database)/documents/platform_settings/global) &&
                         get(/databases/$(database)/documents/platform_settings/global).data.testRideModeEnabled == true &&
                         (isAuthorizedTestCustomer() || isStaffOrAdmin()))) &&
                       isValidBooking(incoming());
      allow update: if isSignedIn() &&
                       isValidId(bookingId) &&
                       incoming().customerId == existing().customerId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidBookingUpdate(incoming()) && (
                         // Customer participant actions
                         (request.auth.uid == existing().customerId && (
                           // Verify pickup OTP atomically against test_ride_otps/{bookingId} (arrived -> in_progress)
                           ('is_test_ride' in existing() &&
                            existing().is_test_ride == true &&
                            existing().status == 'arrived' &&
                            incoming().status == 'in_progress' &&
                            incoming().test_otp_status == 'verified' &&
                            existsAfter(/databases/$(database)/documents/test_ride_otps/$(bookingId)) &&
                            getAfter(/databases/$(database)/documents/test_ride_otps/$(bookingId)).data.used == true &&
                            getAfter(/databases/$(database)/documents/test_ride_otps/$(bookingId)).data.overridden == false &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'status', 'test_otp_status', 'updatedAt'
                            ])) ||
                           // Confirm accepted offer on real bookings (searching -> assigned) with atomic hashed 6-digit OTP
                           ((!('is_test_ride' in existing()) || existing().is_test_ride != true) &&
                            existing().status == 'searching' &&
                            incoming().status == 'assigned' &&
                            incoming().assignedDriverId is string && incoming().assignedDriverId.size() >= 1 &&
                            incoming().acceptedOfferId is string && isValidId(incoming().acceptedOfferId) &&
                            exists(/databases/$(database)/documents/ride_offers/$(incoming().acceptedOfferId)) &&
                            get(/databases/$(database)/documents/ride_offers/$(incoming().acceptedOfferId)).data.bookingId == bookingId &&
                            get(/databases/$(database)/documents/ride_offers/$(incoming().acceptedOfferId)).data.driverId == incoming().assignedDriverId &&
                            !exists(/databases/$(database)/documents/ride_assignments/$(bookingId)) &&
                            existsAfter(/databases/$(database)/documents/ride_otps/$(bookingId)) &&
                            incoming().agreedFareInr >= existing().minPermittedFareInr &&
                            incoming().agreedFareInr <= existing().maxPermittedFareInr &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'status', 'assignedDriverId', 'assignedDriverName', 'assignedVehicleLabel',
                              'acceptedOfferId', 'agreedFareInr', 'otp_status', 'otp_expires_at_ms', 'updatedAt'
                            ])) ||
                           // Cancel before trip starts
                           (existing().status in ['searching', 'assigned', 'arriving', 'arrived'] &&
                            incoming().status == 'cancelled' &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'status', 'cancellationReason', 'cancelledBy', 'cancelledByRole', 'cancellationCategory', 'updatedAt'
                            ])) ||
                           // Submit rating after completion
                           (existing().status == 'completed' &&
                            incoming().status == 'completed' &&
                            !('customerRating' in existing()) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['customerRating', 'updatedAt']))
                         )) ||
                         // Assigned driver / Test Rider actions
                         ('assignedDriverId' in existing() && request.auth.uid == existing().assignedDriverId && (
                           // Verify customer pickup OTP atomically against test_ride_otps/{bookingId} (arrived -> in_progress)
                           ('is_test_ride' in existing() &&
                            existing().is_test_ride == true &&
                            existing().status == 'arrived' &&
                            incoming().status == 'in_progress' &&
                            incoming().test_otp_status == 'verified' &&
                            existsAfter(/databases/$(database)/documents/test_ride_otps/$(bookingId)) &&
                            getAfter(/databases/$(database)/documents/test_ride_otps/$(bookingId)).data.used == true &&
                            getAfter(/databases/$(database)/documents/test_ride_otps/$(bookingId)).data.overridden == false &&
                            getAfter(/databases/$(database)/documents/test_ride_otps/$(bookingId)).data.verifiedByUid == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'status', 'test_otp_status', 'updatedAt'
                            ])) ||
                           // Verify commercial customer pickup OTP atomically against ride_otps/{bookingId} (arrived -> in_progress)
                           ((!('is_test_ride' in existing()) || existing().is_test_ride != true) &&
                            existing().status == 'arrived' &&
                            incoming().status == 'in_progress' &&
                            incoming().otp_status == 'verified' &&
                            existsAfter(/databases/$(database)/documents/ride_otps/$(bookingId)) &&
                            getAfter(/databases/$(database)/documents/ride_otps/$(bookingId)).data.used == true &&
                            getAfter(/databases/$(database)/documents/ride_otps/$(bookingId)).data.overridden == false &&
                            getAfter(/databases/$(database)/documents/ride_otps/$(bookingId)).data.verifiedByUid == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'status', 'otp_status', 'updatedAt'
                            ])) ||
                           // Cancel before trip starts
                           (existing().status in ['assigned', 'arriving', 'arrived'] &&
                            incoming().status == 'cancelled' &&
                            incoming().cancelledBy == request.auth.uid &&
                            incoming().cancelledByRole == 'driver' &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'status', 'cancellationReason', 'cancelledBy', 'cancelledByRole', 'cancellationCategory', 'updatedAt'
                            ])) ||
                           // Submit optional customer feedback after completion
                           (existing().status == 'completed' &&
                            incoming().status == 'completed' &&
                            !('customerFeedbackRating' in existing()) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['customerFeedbackRating', 'customerFeedbackNote', 'updatedAt'])) ||
                           // Advance active trip state (NEVER allowed to jump arrived -> in_progress without verified OTP challenge!)
                           (!(existing().status in ['completed', 'cancelled']) &&
                            ((existing().status == 'assigned' && incoming().status == 'arriving') ||
                             (existing().status == 'arriving' && incoming().status == 'arrived') ||
                             (existing().status == 'in_progress' && incoming().status == 'completed' &&
                              ((!('is_test_ride' in existing()) || existing().is_test_ride != true) ||
                               incoming().paymentStatus == existing().paymentStatus))) &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'status', 'paymentStatus', 'updatedAt'
                            ]))
                         )) ||
                         // Action: Verified Commercial Rider claims an unassigned searching commercial ride atomically (searching -> assigned)
                         ((!('is_test_ride' in existing()) || existing().is_test_ride != true) &&
                          existing().status == 'searching' &&
                          incoming().status == 'assigned' &&
                          incoming().assignedDriverId == request.auth.uid &&
                          isVerifiedDriver() &&
                          !exists(/databases/$(database)/documents/ride_assignments/$(bookingId)) &&
                          existsAfter(/databases/$(database)/documents/ride_assignments/$(bookingId)) &&
                          getAfter(/databases/$(database)/documents/ride_assignments/$(bookingId)).data.driverId == request.auth.uid &&
                          existsAfter(/databases/$(database)/documents/ride_otps/$(bookingId)) &&
                          incoming().agreedFareInr >= existing().minPermittedFareInr &&
                          incoming().agreedFareInr <= existing().maxPermittedFareInr &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'assignedDriverId', 'assignedDriverName', 'assignedVehicleLabel',
                            'agreedFareInr', 'otp_status', 'otp_expires_at_ms', 'updatedAt'
                          ])) ||
                         // Action: Approved Test Rider claims an unassigned searching Test Ride (searching -> assigned)
                         ('is_test_ride' in existing() &&
                          existing().is_test_ride == true &&
                          existing().status == 'searching' &&
                          incoming().status == 'assigned' &&
                          incoming().assignedDriverId == request.auth.uid &&
                          isApprovedTestRider() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'assignedDriverId', 'assignedDriverName', 'assignedVehicleLabel',
                            'agreedFareInr', 'test_otp_status', 'test_otp_expires_at_ms', 'updatedAt'
                          ])) ||
                         // Action: Operations Staff manages Admin-controlled Test Rides ONLY (cannot bypass OTP or assign unauthorized partners)
                         ('is_test_ride' in existing() &&
                          existing().is_test_ride == true &&
                          incoming().is_test_ride == true &&
                          incoming().test_mode == true &&
                          isOperationsStaff() &&
                          (('assignedDriverId' in existing() && incoming().assignedDriverId == existing().assignedDriverId) ||
                           incoming().assignedDriverId == '' ||
                           isAuthorizedTestPartnerId(incoming().assignedDriverId)) &&
                          (existing().status != 'arrived' ||
                           incoming().status != 'in_progress' ||
                           (exists(/databases/$(database)/documents/test_ride_otps/$(bookingId)) &&
                            (get(/databases/$(database)/documents/test_ride_otps/$(bookingId)).data.used == true ||
                             get(/databases/$(database)/documents/test_ride_otps/$(bookingId)).data.overridden == true))) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'assignedDriverId', 'assignedDriverName', 'assignedVehicleLabel',
                            'agreedFareInr', 'test_otp_status', 'test_otp_expires_at_ms',
                            'cancellationReason', 'cancelledBy', 'cancelledByRole', 'cancellationCategory',
                            'updatedAt'
                          ])) ||
                         // Action: Owner Admin manages bookings & test rides (assigning test drivers still requires authorized test partner, and arrived -> in_progress requires verified/overridden OTP)
                         (isAdmin() &&
                          (!('is_test_ride' in existing()) ||
                           existing().is_test_ride != true ? (
                             existing().status != 'arrived' ||
                             incoming().status != 'in_progress' ||
                             (existsAfter(/databases/$(database)/documents/ride_otps/$(bookingId)) &&
                              (getAfter(/databases/$(database)/documents/ride_otps/$(bookingId)).data.used == true ||
                               getAfter(/databases/$(database)/documents/ride_otps/$(bookingId)).data.overridden == true))
                           ) : (
                             (('assignedDriverId' in existing() && incoming().assignedDriverId == existing().assignedDriverId) ||
                              incoming().assignedDriverId == '' ||
                              isAuthorizedTestPartnerId(incoming().assignedDriverId)) &&
                             (existing().status != 'arrived' ||
                              incoming().status != 'in_progress' ||
                              (existsAfter(/databases/$(database)/documents/test_ride_otps/$(bookingId)) &&
                               (getAfter(/databases/$(database)/documents/test_ride_otps/$(bookingId)).data.used == true ||
                                getAfter(/databases/$(database)/documents/test_ride_otps/$(bookingId)).data.overridden == true)))
                           )))
                       );
      allow delete: if isStaffOrAdmin() &&
                       isValidId(bookingId) &&
                       'is_test_ride' in existing() &&
                       existing().is_test_ride == true &&
                       existing().status in ['completed', 'cancelled'];
    }

    // 8. Controlled driver fare proposals (strictly gated to verified drivers & permitted fare bounds; blocked for test rides)
    match /ride_offers/{offerId} {
      allow get: if isSignedIn() && isValidId(offerId) &&
                    (existing().customerId == request.auth.uid || existing().driverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.driverId == request.auth.uid ||
                      isAdmin());
      allow create: if isVerifiedDriver() &&
                       isValidId(offerId) &&
                       incoming().driverId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       isValidRideOffer(incoming()) &&
                       exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
                       (!('is_test_ride' in get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data) ||
                        get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.is_test_ride != true) &&
                       get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status == 'searching' &&
                       get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.customerId == incoming().customerId &&
                       incoming().proposedFareInr >= get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.minPermittedFareInr &&
                       incoming().proposedFareInr <= get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.maxPermittedFareInr;
      allow update: if isSignedIn() &&
                       isValidId(offerId) &&
                       isValidRideOffer(incoming()) &&
                       incoming().bookingId == existing().bookingId &&
                       incoming().customerId == existing().customerId &&
                       incoming().driverId == existing().driverId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (request.auth.uid == existing().customerId &&
                          existing().status == 'pending' &&
                          incoming().status in ['accepted', 'rejected'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                         (request.auth.uid == existing().driverId &&
                          existing().status == 'pending' &&
                          incoming().status == 'expired' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                       );
      allow delete: if false;
    }

    // 9. Ride assignments (1 doc per bookingId prevents duplicate driver assignment)
    match /ride_assignments/{assignmentId} {
      allow get: if isSignedIn() && isValidId(assignmentId) &&
                    (existing().customerId == request.auth.uid ||
                     existing().driverId == request.auth.uid ||
                     (isOperationsStaff() && 'is_test_ride' in existing() && existing().is_test_ride == true) ||
                     isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.driverId == request.auth.uid ||
                      (isOperationsStaff() && resource.data.is_test_ride == true) ||
                      isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(assignmentId) &&
                       assignmentId == incoming().bookingId &&
                       incoming().status == 'active' &&
                       isValidRideAssignment(incoming()) && (
                         ((incoming().customerId == request.auth.uid ||
                           (isVerifiedDriver() &&
                            incoming().driverId == request.auth.uid &&
                            existsAfter(/databases/$(database)/documents/bookings/$(assignmentId)) &&
                            getAfter(/databases/$(database)/documents/bookings/$(assignmentId)).data.assignedDriverId == request.auth.uid) ||
                           isAdmin()) &&
                          (!('is_test_ride' in incoming()) || incoming().is_test_ride == false)) ||
                         ((isStaffOrAdmin() || (isApprovedTestRider() && incoming().driverId == request.auth.uid)) &&
                          incoming().is_test_ride == true &&
                          existsAfter(/databases/$(database)/documents/bookings/$(assignmentId)) &&
                          getAfter(/databases/$(database)/documents/bookings/$(assignmentId)).data.is_test_ride == true &&
                          getAfter(/databases/$(database)/documents/bookings/$(assignmentId)).data.assignedDriverId == incoming().driverId &&
                          isAuthorizedTestPartnerId(incoming().driverId))
                       );
      allow update: if isSignedIn() &&
                       isValidId(assignmentId) &&
                       isValidRideAssignment(incoming()) &&
                       incoming().bookingId == existing().bookingId &&
                       incoming().customerId == existing().customerId &&
                       incoming().createdAt == existing().createdAt && (
                         (isAdmin() &&
                          (incoming().driverId == existing().driverId ||
                           ('is_test_ride' in existing() && existing().is_test_ride == true && isAuthorizedTestPartnerId(incoming().driverId)))) ||
                         (isOperationsStaff() &&
                          'is_test_ride' in existing() &&
                          existing().is_test_ride == true &&
                          incoming().is_test_ride == true &&
                          isAuthorizedTestPartnerId(incoming().driverId)) ||
                         ((request.auth.uid == existing().driverId || request.auth.uid == existing().customerId) &&
                          incoming().driverId == existing().driverId &&
                          existing().status == 'active' &&
                          incoming().status in ['completed', 'cancelled'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                       );
      allow delete: if isStaffOrAdmin() &&
                       isValidId(assignmentId) &&
                       'is_test_ride' in existing() &&
                       existing().is_test_ride == true;
    }

    // 10. Live trip driver locations (bound to assigned driver OR Admin/Ops simulator for test rides)
    match /trip_locations/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) &&
                    (existing().customerId == request.auth.uid || existing().driverId == request.auth.uid || isOperationsStaff() || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.driverId == request.auth.uid ||
                      isOperationsStaff() ||
                      isAdmin());
      allow create, update: if isSignedIn() &&
                               isValidId(bookingId) &&
                               incoming().bookingId == bookingId &&
                               existsAfter(/databases/$(database)/documents/bookings/$(bookingId)) &&
                               getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.status in ['assigned', 'arriving', 'arrived', 'in_progress'] &&
                               isValidTripLocation(incoming()) && (
                                 (incoming().driverId == request.auth.uid &&
                                  getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedDriverId == request.auth.uid) ||
                                 (isStaffOrAdmin() &&
                                  'is_test_ride' in getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data &&
                                  getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.is_test_ride == true &&
                                  incoming().customerId == getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId)
                               );
      allow delete: if isAdmin() ||
                       (isOperationsStaff() &&
                        isValidId(bookingId) &&
                        (!exists(/databases/$(database)/documents/bookings/$(bookingId)) ||
                         ('is_test_ride' in get(/databases/$(database)/documents/bookings/$(bookingId)).data &&
                          get(/databases/$(database)/documents/bookings/$(bookingId)).data.is_test_ride == true)));
    }

    // 10b. Live driver coordinate stream (live_locations/{driverId}) synced with trip telemetry
    match /live_locations/{locationId} {
      allow get: if isSignedIn() && isValidId(locationId) &&
                    (existing().driverId == request.auth.uid ||
                     existing().customerId == request.auth.uid ||
                     isOperationsStaff() ||
                     isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.driverId == request.auth.uid ||
                      resource.data.customerId == request.auth.uid ||
                      isOperationsStaff() ||
                      isAdmin());
      allow create, update: if isSignedIn() &&
                               isValidId(locationId) &&
                               isValidLiveLocation(incoming(), locationId) &&
                               existsAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
                               getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status in ['assigned', 'arriving', 'arrived', 'in_progress'] && (
                                 (locationId == request.auth.uid &&
                                  getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.assignedDriverId == request.auth.uid) ||
                                 (isStaffOrAdmin() &&
                                  incoming().isTestRide == true &&
                                  'is_test_ride' in getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data &&
                                  getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.is_test_ride == true)
                               );
      allow delete: if isAdmin() ||
                       (isOperationsStaff() && isValidId(locationId) && existing().isTestRide == true);
    }

    // 11. Idempotent payment records (keyed by bookingId; test rides strictly excluded from production payments)
    match /payments/{paymentId} {
      allow get: if isSignedIn() && isValidId(paymentId) &&
                    (existing().customerId == request.auth.uid || existing().driverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.driverId == request.auth.uid ||
                      isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(paymentId) &&
                       paymentId == incoming().bookingId &&
                       (incoming().customerId == request.auth.uid || incoming().driverId == request.auth.uid || isAdmin()) &&
                       (incoming().paymentMethod == 'cash' || incoming().status == 'pending_verification' || isAdmin()) &&
                       (!exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) ||
                        !('is_test_ride' in get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data) ||
                        get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.is_test_ride != true) &&
                       isValidPaymentRecord(incoming());
      allow update: if isAdmin() && isValidId(paymentId) && isValidPaymentRecord(incoming());
      allow delete: if false;
    }

    // 12. Commission ledger (idempotent per bookingId, immutable after creation; test rides strictly excluded)
    match /commissions/{commissionId} {
      allow get: if isSignedIn() && isValidId(commissionId) &&
                    (existing().driverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(commissionId) &&
                       commissionId == incoming().bookingId &&
                       (incoming().driverId == request.auth.uid || isAdmin()) &&
                       (!exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) ||
                        !('is_test_ride' in get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data) ||
                        get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.is_test_ride != true) &&
                       isValidCommissionRecord(incoming());
      allow update, delete: if false;
    }

    // 13. Driver settlement / withdrawal requests (verified drivers only)
    match /driver_settlements/{settlementId} {
      allow get: if isSignedIn() && isValidId(settlementId) &&
                    (existing().driverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isVerifiedDriver() &&
                       isValidId(settlementId) &&
                       incoming().driverId == request.auth.uid &&
                       incoming().status == 'requested' &&
                       isValidDriverSettlement(incoming());
      allow update: if isAdmin() &&
                       isValidId(settlementId) &&
                       isValidDriverSettlement(incoming()) &&
                       incoming().driverId == existing().driverId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // 14. Customer refund requests
    match /refunds/{refundId} {
      allow get: if isSignedIn() && isValidId(refundId) &&
                    (existing().customerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(refundId) &&
                       incoming().customerId == request.auth.uid &&
                       incoming().status == 'requested' &&
                       isValidRefundRecord(incoming());
      allow update: if isAdmin() &&
                       isValidId(refundId) &&
                       isValidRefundRecord(incoming()) &&
                       incoming().customerId == existing().customerId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // 15. Ride ratings
    match /ratings/{ratingId} {
      allow get: if isSignedIn() && isValidId(ratingId);
      allow list: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.driverId == request.auth.uid ||
                      isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(ratingId) &&
                       ratingId == incoming().bookingId &&
                       incoming().customerId == request.auth.uid &&
                       isValidRatingRecord(incoming());
      allow update, delete: if false;
    }

    // 16. Complaints
    match /complaints/{complaintId} {
      allow get: if isSignedIn() && isValidId(complaintId) &&
                    (existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(complaintId) &&
                       incoming().reporterId == request.auth.uid &&
                       incoming().status == 'open' &&
                       isValidComplaintRecord(incoming());
      allow update: if isAdmin() &&
                       isValidId(complaintId) &&
                       isValidComplaintRecord(incoming());
      allow delete: if false;
    }

    // 17. Emergency SOS events
    match /emergency_events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId) &&
                    (existing().userId == request.auth.uid || isAuthorizedEmergencyPersonnel() || isOperationsStaff());
      allow list: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAuthorizedEmergencyPersonnel() || isOperationsStaff());
      allow create: if isSignedIn() &&
                       isValidId(eventId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'active' &&
                       isValidEmergencyEvent(incoming());
      allow update: if (isAuthorizedEmergencyPersonnel() || isOperationsStaff()) &&
                       isValidId(eventId) &&
                       isValidEmergencyEvent(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // 18. Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) &&
                    (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(notificationId) &&
                       (incoming().userId == request.auth.uid || isStaffOrAdmin()) &&
                       isValidNotification(incoming());
      allow update: if isSignedIn() &&
                       isValidId(notificationId) &&
                       existing().userId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
                       incoming().read is bool;
      allow delete: if isAdmin();
    }

    // 19. Support, community transport, privacy & account deletion requests
    match /support_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) &&
                    (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'submitted' &&
                       isValidSupportRequest(incoming());
      allow update: if isAdmin() &&
                       isValidId(requestId) &&
                       isValidSupportRequest(incoming());
      allow delete: if false;
    }

    // 20. Immutable admin & operations audit logs (Ops Staff limited to test-ride audit records)
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) &&
                    (isAdmin() || (isOperationsStaff() && 'isTestRide' in existing() && existing().isTestRide == true));
      allow list: if isAdmin() || (isOperationsStaff() && resource.data.isTestRide == true);
      allow create: if isStaffOrAdmin() &&
                       isValidId(logId) &&
                       incoming().actorId == request.auth.uid &&
                       (isAdmin() || incoming().isTestRide == true) &&
                       isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    // 21. Admin role allowlist (Bootstrapped admin manages secondary admins)
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isBootstrappedAdmin();
    }

    // 21b. Operations staff allowlist (Admin-managed; NO default access and NO Owner Admin privileges)
    match /operations_staff/{staffUid} {
      allow get: if isSignedIn() && isValidId(staffUid) && (request.auth.uid == staffUid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() &&
                       isValidId(staffUid) &&
                       incoming().userId == staffUid &&
                       isValidOperationsStaff(incoming());
      allow update: if isAdmin() &&
                       isValidId(staffUid) &&
                       isValidOperationsStaff(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(staffUid);
    }

    // 22. Global platform settings (signed-in read, admin-only write)
    match /platform_settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(settingId) && isValidPlatformSettings(incoming());
      allow delete: if false;
    }

    // 22b. Admin Test Ride hashed OTP challenge (customer NEVER gets read; Ops can only request override; ONLY Owner Admin executes override; Customer OR Assigned Test Rider can verify hash)
    match /test_ride_otps/{bookingId} {
      allow get, list: if isStaffOrAdmin();
      allow create: if (isStaffOrAdmin() ||
                        (isApprovedTestRider() &&
                         existsAfter(/databases/$(database)/documents/bookings/$(bookingId)) &&
                         getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedDriverId == request.auth.uid)) &&
                       isValidId(bookingId) &&
                       existsAfter(/databases/$(database)/documents/bookings/$(bookingId)) &&
                       getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.is_test_ride == true &&
                       incoming().overridden == false &&
                       incoming().used == false &&
                       incoming().attempts == 0 &&
                       isValidTestRideOtpChallenge(incoming(), bookingId);
      allow update: if isSignedIn() &&
                       isValidId(bookingId) &&
                       isValidTestRideOtpChallenge(incoming(), bookingId) &&
                       incoming().bookingId == existing().bookingId &&
                       incoming().customerId == existing().customerId && (
                         (isAdmin() &&
                          (incoming().overridden == false ||
                           (exists(/databases/$(database)/documents/platform_settings/global) &&
                            get(/databases/$(database)/documents/platform_settings/global).data.testAllowAdminOtpOverride == true &&
                            incoming().overridden == true &&
                            incoming().used == true &&
                            incoming().overriddenByUid == request.auth.uid &&
                            incoming().overrideReason is string &&
                            incoming().overrideReason.size() >= 4))) ||
                         (isOperationsStaff() &&
                          incoming().overridden == false &&
                          ((incoming().used == false &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'overrideRequestedByUid', 'overrideRequestedReason', 'overrideRequestedAt', 'updatedAt'
                            ]) &&
                            incoming().overrideRequestedByUid == request.auth.uid &&
                            incoming().overrideRequestedReason is string &&
                            incoming().overrideRequestedReason.size() >= 4) ||
                           (incoming().used == false && incoming().overridden == false && incoming().attempts == 0))) ||
                         ((existing().customerId == request.auth.uid ||
                           (exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
                            get(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedDriverId == request.auth.uid)) &&
                          incoming().createdAt == existing().createdAt &&
                          existing().used == false &&
                          existing().overridden == false &&
                          existing().attempts < existing().maxAttempts &&
                          request.time <= existing().expiresAt &&
                          incoming().used == true &&
                          incoming().overridden == false &&
                          incoming().submittedHash is string &&
                          incoming().submittedHash == existing().otpHash &&
                          incoming().verifiedByUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['used', 'submittedHash', 'verifiedByUid', 'updatedAt'])) ||
                         ((existing().customerId == request.auth.uid ||
                           (exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
                            get(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedDriverId == request.auth.uid)) &&
                          incoming().createdAt == existing().createdAt &&
                          existing().used == false &&
                          existing().overridden == false &&
                          existing().attempts < existing().maxAttempts &&
                          incoming().used == false &&
                          incoming().overridden == false &&
                          incoming().attempts == existing().attempts + 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['attempts', 'updatedAt']))
                       );
      allow delete: if isStaffOrAdmin() && isValidId(bookingId);
    }

    // 22c. Admin/Ops-only plaintext test ride OTP monitor (zero customer or driver read)
    match /test_ride_otp_secrets/{bookingId} {
      allow get, list: if isStaffOrAdmin();
      allow create, update: if isStaffOrAdmin() &&
                               isValidId(bookingId) &&
                               isValidTestRideOtpSecret(incoming(), bookingId);
      allow delete: if isStaffOrAdmin() && isValidId(bookingId);
    }

    // 22d-1. Commercial Ride hashed 6-digit OTP challenge (never readable by customer or driver; single-use + cooldown + Owner Admin override)
    match /ride_otps/{bookingId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(bookingId) &&
                       existsAfter(/databases/$(database)/documents/bookings/$(bookingId)) &&
                       (!('is_test_ride' in getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data) ||
                        getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.is_test_ride != true) &&
                       (isAdmin() ||
                        incoming().customerId == request.auth.uid ||
                        (isVerifiedDriver() &&
                         getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedDriverId == request.auth.uid)) &&
                       incoming().overridden == false &&
                       incoming().used == false &&
                       incoming().attempts == 0 &&
                       isValidTestRideOtpChallenge(incoming(), bookingId);
      allow update: if isSignedIn() &&
                       isValidId(bookingId) &&
                       isValidTestRideOtpChallenge(incoming(), bookingId) &&
                       incoming().bookingId == existing().bookingId &&
                       incoming().customerId == existing().customerId &&
                       incoming().createdAt == existing().createdAt && (
                         (isAdmin() &&
                          incoming().overridden == true &&
                          incoming().used == true &&
                          incoming().overriddenByUid == request.auth.uid &&
                          incoming().overrideReason is string &&
                          incoming().overrideReason.size() >= 4) ||
                         (exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
                          get(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedDriverId == request.auth.uid &&
                          existing().used == false &&
                          existing().overridden == false &&
                          existing().attempts < existing().maxAttempts &&
                          request.time <= existing().expiresAt &&
                          incoming().used == true &&
                          incoming().overridden == false &&
                          incoming().submittedHash is string &&
                          incoming().submittedHash == existing().otpHash &&
                          incoming().verifiedByUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['used', 'submittedHash', 'verifiedByUid', 'updatedAt'])) ||
                         (exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
                          get(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedDriverId == request.auth.uid &&
                          existing().used == false &&
                          existing().overridden == false &&
                          existing().attempts < existing().maxAttempts &&
                          incoming().used == false &&
                          incoming().overridden == false &&
                          incoming().attempts == existing().attempts + 1 &&
                          incoming().lastAttemptAtMs is int &&
                          (!('lastAttemptAtMs' in existing()) || existing().lastAttemptAtMs == 0 ||
                           request.time.toMillis() - existing().lastAttemptAtMs >= 1500) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['attempts', 'lastAttemptAtMs', 'updatedAt']))
                       );
      allow delete: if isAdmin() && isValidId(bookingId);
    }

    // 22d-2. Persisted driver ride rejections (prevents rejected/expired requests from reappearing to the same driver)
    match /ride_rejections/{rejectionId} {
      allow get: if isSignedIn() && isValidId(rejectionId) &&
                    (existing().driverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() &&
                               isValidId(rejectionId) &&
                               incoming().driverId == request.auth.uid &&
                               incoming().bookingId is string && isValidId(incoming().bookingId) &&
                               isOptionalString(incoming(), 'reason', 60) &&
                               isValidTimestamp(incoming().createdAt);
      allow delete: if isAdmin();
    }

    // 22d. Customer-only visible pickup OTP display secret (readable ONLY by owner customer or Admin/Ops, NEVER by riders/outsiders)
    match /ride_otp_secrets/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) &&
                    (existing().customerId == request.auth.uid || isStaffOrAdmin());
      allow list: if isStaffOrAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(bookingId) &&
                       (isStaffOrAdmin() ||
                        incoming().customerId == request.auth.uid ||
                        ((isVerifiedDriver() || isApprovedTestRider()) &&
                         existsAfter(/databases/$(database)/documents/bookings/$(bookingId)) &&
                         getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedDriverId == request.auth.uid)) &&
                       incoming().bookingId == bookingId &&
                       incoming().customerId is string && incoming().customerId.size() >= 1 &&
                       incoming().otpPlaintext is string && incoming().otpPlaintext.size() >= 4 && incoming().otpPlaintext.size() <= 8 &&
                       incoming().status in ['pending', 'verified', 'overridden', 'expired', 'reset'] &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isSignedIn() &&
                       isValidId(bookingId) && (
                         (isStaffOrAdmin() &&
                          incoming().bookingId == existing().bookingId &&
                          incoming().customerId == existing().customerId &&
                          incoming().otpPlaintext is string && incoming().otpPlaintext.size() >= 4 && incoming().otpPlaintext.size() <= 8 &&
                          incoming().status in ['pending', 'verified', 'overridden', 'expired', 'reset'] &&
                          isValidTimestamp(incoming().updatedAt)) ||
                         ((incoming().customerId == existing().customerId) &&
                          (request.auth.uid == existing().customerId ||
                           ((isVerifiedDriver() || isApprovedTestRider()) &&
                            exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
                            get(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedDriverId == request.auth.uid)) &&
                          incoming().otpPlaintext == existing().otpPlaintext &&
                          incoming().status in ['pending', 'verified', 'overridden', 'expired', 'reset'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                          isValidTimestamp(incoming().updatedAt))
                       );
      allow delete: if isStaffOrAdmin() && isValidId(bookingId);
    }

    // 22e. Isolated Test Rider onboarding requests & Admin RBAC workflow (never auto-verifies commercial KYC)
    match /test_rider_requests/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isStaffOrAdmin());
      allow list: if isStaffOrAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(uid) &&
                       request.auth.uid == uid &&
                       incoming().uid == request.auth.uid &&
                       incoming().status == 'pending' &&
                       (!('reviewedByUid' in incoming()) || incoming().reviewedByUid == '') &&
                       (!('opsRecommendation' in incoming()) || incoming().opsRecommendation == '') &&
                       (!('isOnline' in incoming()) || incoming().isOnline == false) &&
                       isValidTestRiderRequest(incoming());
      allow update: if isSignedIn() &&
                       isValidId(uid) &&
                       isValidTestRiderRequest(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt && (
                         // Owner Admin full governance (approve, reject with reason, suspend, revoke, notes)
                         (isAdmin() &&
                          (incoming().status in ['pending', 'approved'] ||
                           (incoming().rejectionReason is string && incoming().rejectionReason.size() >= 4)) &&
                          incoming().reviewedByUid == request.auth.uid) ||
                         // Operations Staff ONLY recommends approve/reject + note (CANNOT directly change status!)
                         (isOperationsStaff() &&
                          incoming().status == existing().status &&
                          incoming().rejectionReason == existing().rejectionReason &&
                          incoming().reviewedByUid == existing().reviewedByUid &&
                          incoming().opsRecommendation in ['', 'recommend_approve', 'recommend_reject'] &&
                          incoming().opsRecommendedByUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'opsRecommendation', 'opsRecommendedByUid', 'opsRecommendedNote', 'updatedAt'
                          ])) ||
                         // Applicant can reapply ONLY when previously rejected (resets to pending) or update contact/online when approved
                         (request.auth.uid == uid && (
                           (existing().status == 'rejected' &&
                            incoming().status == 'pending' &&
                            incoming().rejectionReason == '' &&
                            incoming().reviewedByUid == '' &&
                            incoming().opsRecommendation == '' &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'fullName', 'mobileNumber', 'email', 'vehicleCategory', 'testPurpose',
                              'notes', 'status', 'rejectionReason', 'reviewedByUid', 'opsRecommendation',
                              'deviceInfoSummary', 'updatedAt'
                            ])) ||
                           (existing().status == 'approved' &&
                            incoming().status == 'approved' &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['isOnline', 'deviceInfoSummary', 'updatedAt']))
                         ))
                       );
      allow delete: if isAdmin() && isValidId(uid);
    }

    // 22f. Approved Test Rider directory/state (isolated from commercial driver_profiles KYC)
    match /test_riders/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isStaffOrAdmin());
      allow list: if isStaffOrAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isSignedIn() &&
                               isValidId(uid) &&
                               isValidTestRiderProfile(incoming()) && (
                                 isAdmin() ||
                                 (request.auth.uid == uid &&
                                  exists(/databases/$(database)/documents/test_riders/$(uid)) &&
                                  existing().status == 'approved' &&
                                  incoming().status == 'approved' &&
                                  incoming().uid == existing().uid &&
                                  incoming().diff(existing()).affectedKeys().hasOnly([
                                    'isOnline', 'currentLat', 'currentLng', 'updatedAt'
                                  ]))
                               );
      allow delete: if isAdmin() && isValidId(uid);
    }

    // 22g. Immutable Test Rider decision & recommendation audit log
    match /test_rider_audit_logs/{logId} {
      allow get, list: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin() &&
                       isValidId(logId) &&
                       incoming().actorUid == request.auth.uid &&
                       isValidTestRiderAuditLog(incoming());
      allow update, delete: if false;
    }

    // 23. Two-way booking chat (strictly scoped to active booking customer & assigned driver; read-only history once completed/cancelled)
    match /booking_chats/{bookingId}/messages/{messageId} {
      function bookingDoc() {
        return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      }
      allow get, list: if isSignedIn() && isValidId(bookingId) && isValidId(messageId) && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
         (bookingDoc().customerId == request.auth.uid || bookingDoc().assignedDriverId == request.auth.uid))
      );
      allow create: if isSignedIn() &&
                       isValidId(bookingId) &&
                       isValidId(messageId) &&
                       exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
                       bookingDoc().status in ['assigned', 'arriving', 'arrived', 'in_progress'] &&
                       incoming().bookingId == bookingId &&
                       incoming().senderId == request.auth.uid &&
                       incoming().customerId == bookingDoc().customerId &&
                       incoming().driverId == bookingDoc().assignedDriverId &&
                       ((incoming().senderRole == 'customer' && bookingDoc().customerId == request.auth.uid) ||
                        (incoming().senderRole == 'driver' && bookingDoc().assignedDriverId == request.auth.uid)) &&
                       incoming().senderName is string && incoming().senderName.size() >= 1 && incoming().senderName.size() <= 100 &&
                       incoming().text is string && incoming().text.size() >= 1 && incoming().text.size() <= 500 &&
                       incoming().deliveryState in ['sent', 'delivered'] &&
                       isValidTimestamp(incoming().createdAt);
      allow update: if isSignedIn() &&
                       isValidId(bookingId) &&
                       isValidId(messageId) &&
                       exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
                       (bookingDoc().customerId == request.auth.uid || bookingDoc().assignedDriverId == request.auth.uid) &&
                       request.auth.uid != existing().senderId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['deliveryState', 'readByCustomer', 'readByDriver']) &&
                       incoming().deliveryState in ['delivered', 'read'];
      allow delete: if false;
    }

    // 24. Active-trip participant contact bridge (strictly isolated to booking participants while trip is active)
    match /booking_contacts/{bookingId} {
      function tripDoc() {
        return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      }
      allow get: if isSignedIn() && isValidId(bookingId) && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
         tripDoc().status in ['assigned', 'arriving', 'arrived', 'in_progress'] &&
         (tripDoc().customerId == request.auth.uid || tripDoc().assignedDriverId == request.auth.uid))
      );
      allow list: if isAdmin();
      allow create, update: if isSignedIn() &&
                               isValidId(bookingId) &&
                               exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
                               tripDoc().status in ['assigned', 'arriving', 'arrived', 'in_progress'] &&
                               incoming().bookingId == bookingId &&
                               incoming().customerId == tripDoc().customerId &&
                               incoming().driverId == tripDoc().assignedDriverId &&
                               (request.auth.uid == tripDoc().customerId || request.auth.uid == tripDoc().assignedDriverId || isAdmin()) &&
                               isOptionalString(incoming(), 'customerPhone', 25) &&
                               isOptionalString(incoming(), 'driverPhone', 25) &&
                               isOptionalString(incoming(), 'customerFirstName', 80) &&
                               isOptionalString(incoming(), 'driverName', 100) &&
                               isValidTimestamp(incoming().updatedAt);
      allow delete: if isAdmin();
    }

    // 25. Driver KYC verification decision audit trail
    match /driver_verification_history/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId) && (existing().driverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidId(entryId) &&
                       incoming().driverId is string && incoming().reviewerId == request.auth.uid &&
                       incoming().decision in ['pending', 'verified', 'rejected', 'suspended'] &&
                       isOptionalString(incoming(), 'reason', 300) &&
                       isValidTimestamp(incoming().createdAt);
      allow update, delete: if false;
    }

    // 26. Cancellation fee / suspension appeals
    match /cancellation_appeals/{appealId} {
      allow get: if isSignedIn() && isValidId(appealId) && (existing().appellantId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.appellantId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(appealId) &&
                       incoming().appellantId == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().reason is string && incoming().reason.size() >= 5 && incoming().reason.size() <= 400 &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isAdmin() && isValidId(appealId) && incoming().status in ['open', 'accepted', 'rejected'];
      allow delete: if false;
    }

    // 27. FCM device tokens (strictly owner or admin; supports multi-device registration)
    match /user_tokens/{tokenId} {
      allow get: if isSignedIn() && isValidId(tokenId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() &&
                               isValidId(tokenId) &&
                               incoming().userId == request.auth.uid &&
                               incoming().platform == 'android' &&
                               incoming().appVariant in ['customer', 'rider', 'admin'] &&
                               incoming().active is bool &&
                               isOptionalString(incoming(), 'deviceId', 128) &&
                               (!('appVersionCode' in incoming()) || incoming().appVersionCode is int) &&
                               isOptionalString(incoming(), 'token', 400) &&
                               isValidTimestamp(incoming().updatedAt);
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 28. Private Bus Booking Module (operators, routes, schedules, and atomic seat bookings)
    match /bus_operators/{operatorId} {
      allow get, list: if isSignedIn() && (resource.data.verificationStatus == 'verified' || isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin() && isValidId(operatorId) && isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt);
      allow update: if isAdmin() && isValidId(operatorId) && isValidTimestamp(incoming().updatedAt);
      allow delete: if isAdmin();
    }

    match /bus_routes/{routeId} {
      allow get, list: if isSignedIn() && (resource.data.status == 'active' || isAdmin());
      allow create, update: if isAdmin() && isValidId(routeId) &&
                               incoming().status in ['pending_pricing', 'active', 'suspended'] &&
                               (incoming().status != 'active' ||
                                (incoming().fareSource is string && incoming().fareSource.size() >= 2 &&
                                 incoming().effectiveDateLabel is string && incoming().effectiveDateLabel.size() >= 4 &&
                                 incoming().baseSeatFareInr is number && incoming().baseSeatFareInr > 0 &&
                                 incoming().distanceKm is number && incoming().distanceKm > 0)) &&
                               isValidTimestamp(incoming().updatedAt);
      allow delete: if isAdmin();
    }

    match /bus_schedules/{scheduleId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && isValidId(scheduleId) &&
                       incoming().totalSeats is int && incoming().totalSeats >= 10 && incoming().totalSeats <= 80 &&
                       incoming().fareSource is string && incoming().fareSource.size() >= 2 &&
                       incoming().farePerSeatInr is number && incoming().farePerSeatInr >= 10 &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isSignedIn() && isValidId(scheduleId) && (
        isAdmin() ||
        (existing().status == 'scheduled' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['bookedSeats', 'updatedAt']) &&
         incoming().bookedSeats is list &&
         incoming().bookedSeats.size() > existing().bookedSeats.size() &&
         incoming().bookedSeats.size() <= existing().bookedSeats.size() + 6 &&
         incoming().bookedSeats.size() <= existing().totalSeats &&
         isValidTimestamp(incoming().updatedAt))
      );
      allow delete: if isAdmin();
    }

    match /bus_bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) && (existing().customerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(bookingId) &&
                       incoming().customerId == request.auth.uid &&
                       incoming().status == 'confirmed' &&
                       incoming().seatNumbers is list &&
                       incoming().seatNumbers.size() >= 1 && incoming().seatNumbers.size() <= 6 &&
                       incoming().seatCount == incoming().seatNumbers.size() &&
                       incoming().totalFareInr is number && incoming().totalFareInr >= 10 &&
                       exists(/databases/$(database)/documents/bus_schedules/$(incoming().scheduleId)) &&
                       get(/databases/$(database)/documents/bus_schedules/$(incoming().scheduleId)).data.status == 'scheduled' &&
                       get(/databases/$(database)/documents/bus_schedules/$(incoming().scheduleId)).data.fareSource.size() >= 2 &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isSignedIn() && isValidId(bookingId) && (
        isAdmin() ||
        (existing().customerId == request.auth.uid &&
         existing().status == 'confirmed' &&
         incoming().status == 'cancelled' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancellationReason', 'updatedAt']) &&
         isValidTimestamp(incoming().updatedAt))
      );
      allow delete: if false;
    }

    // 29. Sample Rider phone-auth allowlist (Admin-managed; owner phone can only read their own allowlist doc to check eligibility)
    match /sample_rider_allowlist/{phoneE164} {
      allow get: if isValidPhoneId(phoneE164) &&
                    (isAdmin() || (isPhoneAuthUser() && verifiedPhone() == phoneE164));
      allow list: if isAdmin();
      allow create, update: if isAdmin() &&
                               isValidPhoneId(phoneE164) &&
                               isValidSampleRiderAllowlist(incoming(), phoneE164);
      allow delete: if isAdmin() && isValidPhoneId(phoneE164);
    }

    // 30. Isolated Sample Rider profiles (linked to authenticated Firebase UID; zero commercial KYC required; non-allowlisted users cannot self-create)
    match /sample_riders/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isStaffOrAdmin());
      allow list: if isStaffOrAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(uid) &&
                       isValidSampleRiderProfile(incoming()) && (
                         isAdmin() ||
                         (request.auth.uid == uid &&
                          isAllowlistedSamplePhone() &&
                          incoming().uid == request.auth.uid &&
                          incoming().phone == verifiedPhone() &&
                          incoming().role == 'rider' &&
                          incoming().accountType == 'sample' &&
                          incoming().isSampleRider == true &&
                          incoming().verificationStatus == 'sample_approved' &&
                          incoming().availabilityStatus == 'offline' &&
                          (!('completedSampleRides' in incoming()) || incoming().completedSampleRides == 0) &&
                          (!('totalSampleEarningsInr' in incoming()) || incoming().totalSampleEarningsInr == 0))
                       );
      allow update: if isSignedIn() &&
                       isValidId(uid) &&
                       isValidSampleRiderProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (request.auth.uid == uid &&
                          isAllowlistedSamplePhone() &&
                          existing().isSampleRider == true &&
                          existing().accountType == 'sample' &&
                          existing().verificationStatus == 'sample_approved' &&
                          incoming().role == 'rider' &&
                          incoming().accountType == 'sample' &&
                          incoming().isSampleRider == true &&
                          incoming().verificationStatus == 'sample_approved' &&
                          incoming().phone == existing().phone &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'displayName', 'photoUrl', 'vehicleCategory', 'availabilityStatus',
                            'emergencyContactName', 'emergencyContactPhone',
                            'currentLat', 'currentLng', 'locationUpdatedAt', 'updatedAt'
                          ]))
                       );
      allow delete: if isAdmin() && isValidId(uid);

      match /dismissed_rides/{rideId} {
        allow get, list: if isSignedIn() && isValidId(uid) && isValidId(rideId) &&
                           (request.auth.uid == uid || isAdmin());
        allow create, delete: if isSignedIn() && isValidId(uid) && isValidId(rideId) &&
                                 (request.auth.uid == uid || isAdmin());
      }
    }

    // 31. Isolated Sample Rides (strictly isolated from commercial `bookings`; atomic accept & OTP-gated `in_progress`)
    match /sample_rides/{rideId} {
      allow get: if isSignedIn() && isValidId(rideId) && (
        isStaffOrAdmin() ||
        existing().customerId == request.auth.uid ||
        existing().assignedSampleRiderId == request.auth.uid ||
        (isActiveSampleRider() && existing().status == 'incoming')
      );
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.assignedSampleRiderId == request.auth.uid ||
        isStaffOrAdmin() ||
        (resource.data.status == 'incoming' && isActiveSampleRider())
      );
      allow create: if isSignedIn() &&
                       isValidId(rideId) &&
                       incoming().isSample == true &&
                       incoming().status == 'incoming' &&
                       incoming().assignedSampleRiderId == '' &&
                       incoming().otpVerified == false &&
                       incoming().expiresAt > request.time &&
                       isValidSampleRide(incoming(), rideId) &&
                       (isAdmin() || (incoming().customerId == request.auth.uid && isAuthorizedTestCustomer()));
      allow update: if isSignedIn() &&
                       isValidId(rideId) &&
                       incoming().rideId == existing().rideId &&
                       incoming().customerId == existing().customerId &&
                       incoming().isSample == true &&
                       incoming().createdAt == existing().createdAt &&
                       isValidSampleRide(incoming(), rideId) && (
                         // 1. Atomic acceptance by an active Sample Rider
                         (existing().status == 'incoming' &&
                          incoming().status == 'accepted' &&
                          existing().assignedSampleRiderId == '' &&
                          incoming().assignedSampleRiderId == request.auth.uid &&
                          incoming().otpVerified == false &&
                          request.time <= existing().expiresAt &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'assignedSampleRiderId', 'assignedSampleRiderName',
                            'assignedSampleRiderPhone', 'riderLat', 'riderLng', 'updatedAt'
                          ]) &&
                          isActiveSampleRider()) ||
                         // 2. Assigned Sample Rider pre-OTP progression (accepted -> arriving -> arrived) & real GPS updates
                         (existing().assignedSampleRiderId == request.auth.uid &&
                          existing().status in ['accepted', 'arriving', 'arrived'] &&
                          incoming().status in ['accepted', 'arriving', 'arrived'] &&
                          (incoming().status == existing().status ||
                           (existing().status == 'accepted' && incoming().status in ['arriving', 'arrived']) ||
                           (existing().status == 'arriving' && incoming().status == 'arrived')) &&
                          incoming().assignedSampleRiderId == existing().assignedSampleRiderId &&
                          incoming().otpVerified == false &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'riderLat', 'riderLng', 'updatedAt'
                          ]) &&
                          isActiveSampleRider()) ||
                         // 3. Assigned Sample Rider starts ride ONLY atomically with hashed OTP challenge consumption
                         (existing().assignedSampleRiderId == request.auth.uid &&
                          existing().status == 'arrived' &&
                          incoming().status == 'in_progress' &&
                          incoming().otpVerified == true &&
                          incoming().assignedSampleRiderId == existing().assignedSampleRiderId &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'otpVerified', 'otpVerifiedAt', 'riderLat', 'riderLng', 'updatedAt'
                          ]) &&
                          isActiveSampleRider() &&
                          existsAfter(/databases/$(database)/documents/sample_ride_otps/$(rideId)) &&
                          get(/databases/$(database)/documents/sample_ride_otps/$(rideId)).data.used == false &&
                          getAfter(/databases/$(database)/documents/sample_ride_otps/$(rideId)).data.used == true &&
                          getAfter(/databases/$(database)/documents/sample_ride_otps/$(rideId)).data.verifiedByUid == request.auth.uid) ||
                         // 4. Assigned Sample Rider live GPS & completion after OTP verified
                         (existing().assignedSampleRiderId == request.auth.uid &&
                          existing().status == 'in_progress' &&
                          existing().otpVerified == true &&
                          incoming().otpVerified == true &&
                          incoming().status in ['in_progress', 'completed'] &&
                          incoming().assignedSampleRiderId == existing().assignedSampleRiderId &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'riderLat', 'riderLng', 'completedAt', 'updatedAt'
                          ]) &&
                          isActiveSampleRider()) ||
                         // 5. Mark timed-out incoming sample ride as expired
                         (existing().status == 'incoming' &&
                          incoming().status == 'expired' &&
                          request.time > existing().expiresAt &&
                          incoming().otpVerified == existing().otpVerified &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                          (existing().customerId == request.auth.uid || isActiveSampleRider() || isStaffOrAdmin())) ||
                         // 6. Cancel pre-start sample ride
                         (existing().status in ['incoming', 'accepted', 'arriving', 'arrived'] &&
                          incoming().status == 'cancelled' &&
                          incoming().otpVerified == existing().otpVerified &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancellationReason', 'updatedAt']) &&
                          (existing().customerId == request.auth.uid ||
                           (existing().assignedSampleRiderId == request.auth.uid && isActiveSampleRider()) ||
                           isStaffOrAdmin())) ||
                         // 7. Admin cancellation/cleanup without bypassing OTP rules
                         (incoming().otpVerified == existing().otpVerified &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'cancellationReason', 'expiresAt', 'updatedAt'
                          ]) &&
                          isAdmin())
                       );
      allow delete: if isAdmin() && isValidId(rideId);
    }

    // 32. Hashed Sample Ride 6-digit OTP challenges (NEVER contains readable plaintext OTP; unreadable by client riders)
    match /sample_ride_otps/{rideId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(rideId) &&
                       isValidSampleRideOtpChallenge(incoming(), rideId) &&
                       existsAfter(/databases/$(database)/documents/sample_rides/$(rideId)) &&
                       (isAdmin() ||
                        (isAuthorizedTestCustomer() &&
                         incoming().customerId == request.auth.uid &&
                         getAfter(/databases/$(database)/documents/sample_rides/$(rideId)).data.customerId == request.auth.uid)) &&
                       incoming().used == false &&
                       incoming().attempts == 0 &&
                       incoming().maxAttempts == 5 &&
                       incoming().expiresAt > request.time;
      allow update: if isSignedIn() &&
                       isValidId(rideId) &&
                       isValidSampleRideOtpChallenge(incoming(), rideId) &&
                       incoming().rideId == existing().rideId &&
                       incoming().customerId == existing().customerId &&
                       incoming().otpHash == existing().otpHash &&
                       incoming().createdAt == existing().createdAt &&
                       exists(/databases/$(database)/documents/sample_rides/$(rideId)) &&
                       get(/databases/$(database)/documents/sample_rides/$(rideId)).data.assignedSampleRiderId == request.auth.uid &&
                       isActiveSampleRider() &&
                       existing().used == false &&
                       existing().attempts < existing().maxAttempts && (
                         // Consume challenge when SHA-256(rideId:otp) matches otpHash
                         (request.time <= existing().expiresAt &&
                          incoming().used == true &&
                          incoming().submittedHash is string &&
                          incoming().submittedHash == existing().otpHash &&
                          incoming().verifiedByUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['used', 'submittedHash', 'verifiedByUid', 'updatedAt'])) ||
                         // Record failed OTP attempt (anti-brute-force attempt counter + 1.5s cooldown)
                         (incoming().used == false &&
                          incoming().attempts == existing().attempts + 1 &&
                          incoming().lastAttemptAtMs is int &&
                          (!('lastAttemptAtMs' in existing()) || existing().lastAttemptAtMs == 0 ||
                           request.time.toMillis() - existing().lastAttemptAtMs >= 1500) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['attempts', 'lastAttemptAtMs', 'updatedAt']))
                       );
      allow delete: if isAdmin() && isValidId(rideId);
    }
  }
}
